<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Abstractions DI uniquement (neutres : ni EF, ni Avalonia, ni MVVM) : nécessaires pour
         exposer l'extension AddApplication(this IServiceCollection). Version alignée sur celle
         déjà tirée par MMV.App (Microsoft.Extensions.DependencyInjection 8.0.1). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- SEULE référence projet autorisée (ADR frontières P2B-2A §4.2) : Application -> Domain.
         Interdits : MMV.Infrastructure, MMV.App, EF Core, Sqlite, Avalonia, CommunityToolkit.Mvvm. -->
    <ProjectReference Include="..\MMV.Domain\MMV.Domain.csproj" />
  </ItemGroup>

</Project>
