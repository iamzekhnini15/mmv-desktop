<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- P4-3 (ADR-PROD-DB-002) : fournisseur serveur retenu pour la V1 multi-poste. Référencé
         UNIQUEMENT ici — Domain et Application restent neutres vis-à-vis du fournisseur. Sélectionne
         le provider EF ; ni migration serveur, ni mapping spécifique (P4-4/P4-5). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <!-- P4-NET10 / E-5 : l'épingle System.Text.Json 8.0.6 a été RETIRÉE d'ici. Elle remontait un
         transitif d'EF Core / Microsoft.Extensions.DependencyModel au-delà des avis High
         GHSA-hh2w-p6rv-4g7w et GHSA-8g4q-xg66-9fp4, corrigés depuis 8.0.5. Sur net10.0 le framework
         partagé fournit System.Text.Json 10.x : la garder rétrogradait l'assembly de deux majeures,
         ce que NuGet signalait par NU1510. Ne pas la réintroduire sans un avis qui la justifie. -->
    <!-- Pin de sécurité (P2C-SEC-1), RÉEXAMINÉE en P4-NET10 / E-5 et CONSERVÉE : remonte le natif
         SQLite transitif au-delà de l'avis High GHSA-2m69-gcr7-jv3q / CVE-2025-6965 (corruption
         mémoire dans SQLite < 3.50.2).
         Relevé du 30/09/2026 : Microsoft.EntityFrameworkCore.Sqlite 10.0.12 tire encore
         SQLitePCLRaw.bundle_e_sqlite3 2.1.12 (→ SQLitePCLRaw.lib.e_sqlite3 2.1.12, dont la version
         du binaire SQLite embarqué n'est PAS lisible sur le paquet). Le bundle 3.0.0 tire
         SQLitePCLRaw.lib.e_sqlite3 3.50.3 — numéro qui EST la version de SQLite, donc vérifiable et
         au-dessus du correctif 3.50.2. La montée en EF Core 10 n'a donc rien changé au raisonnement :
         l'épingle reste PORTANTE et n'est pas retirée sur une supposition (plan §4, E-5).
         Correction dépendances uniquement : aucun changement de modèle EF, aucune migration. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
    <!-- P4-8 (ADR-PROD-DB-010, D-13) : DPAPI CurrentUser pour la configuration de connexion par poste.
         Paquet Microsoft, même version que le runtime EF Core 10.0.12 ; utilisé sous garde
         OperatingSystem.IsWindows() uniquement (PlatformNotSupportedException ailleurs). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MMV.Domain\MMV.Domain.csproj" />
  </ItemGroup>

</Project>
