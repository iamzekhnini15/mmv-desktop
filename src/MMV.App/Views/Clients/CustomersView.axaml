<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:views="using:MMV.App.Views.Clients"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.CustomersView"
             x:DataType="vm:CustomersViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="Border.DataRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.DataRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
        </Style>

        <Style Selector="TextBlock.ColHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.FilterInput">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12" IsVisible="{Binding !IsInEditMode}">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Clients" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconUser}" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CustomersListViewModel.TotalCustomers}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding CustomersListViewModel.IsLoading}" Width="80" Height="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBox Classes="FilterInput"
                                 Text="{Binding CustomersListViewModel.SearchText, Mode=TwoWay}"
                                 Watermark="Rechercher..."
                                 Width="250"/>
                        <PathIcon Data="{StaticResource IconSearch}" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Command="{Binding CustomersListViewModel.CreateCommand}" Classes="Primary" Padding="16,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" Width="10" Height="10" Foreground="White"/>
                            <TextBlock Text="Nouveau" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto, *" IsVisible="{Binding ShowList}">

            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                <Grid ColumnDefinitions="50, 2*, 1.5*, 2*, 1.5*, 1.2*">
                    <TextBlock Grid.Column="1" Text="NOM COMPLET" Classes="ColHeader"/>
                    <TextBlock Grid.Column="2" Text="CONTACT" Classes="ColHeader"/>
                    <TextBlock Grid.Column="3" Text="ADRESSE" Classes="ColHeader"/>
                    <TextBlock Grid.Column="4" Text="EMAIL" Classes="ColHeader"/>
                    <TextBlock Grid.Column="5" Text="DATE CRÉATION" Classes="ColHeader" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding CustomersListViewModel.FilteredCustomers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="DataRow" PointerPressed="Border_PointerPressed">
                                    <Grid ColumnDefinitions="50, 2*, 1.5*, 2*, 1.5*, 1.2*">

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SurfaceLightBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding FirstName[0]}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding LastName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FirstName}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" IsVisible="{Binding Phone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <PathIcon Data="{StaticResource IconPhone}" Width="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Phone}" FontSize="13"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding City}" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PostalCode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                       FontSize="12"
                                                       FontFamily="Consolas, Monospace"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding CustomersListViewModel.FilteredCustomers, Converter={x:Static ObjectConverters.IsNull}}"
                                HorizontalAlignment="Center" Margin="0,100" Spacing="15" Opacity="0.5">
                        <PathIcon Data="{StaticResource IconSearch}" Width="48" Height="48" Foreground="{DynamicResource TextDisabledBrush}"/>
                        <TextBlock Text="Aucun résultat" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Modifiez vos filtres ou ajoutez un nouveau client."/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,10" IsVisible="{Binding ShowList}">
            <Grid ColumnDefinitions="*, Auto">

                <TextBlock Grid.Column="0"
                           Text="{Binding CustomersListViewModel.ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="NavButton" Command="{Binding CustomersListViewModel.PreviousPageCommand}">
                        <PathIcon Data="{StaticResource IconBack}" Width="12"/>
                    </Button>

                    <TextBlock Text="{Binding CustomersListViewModel.CurrentPage, StringFormat='Page {0}'}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"/>

                    <Button Classes="NavButton" Command="{Binding CustomersListViewModel.NextPageCommand}">
                        <PathIcon Data="{StaticResource IconBack}" Width="12" RenderTransform="rotate(180deg)"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Panel Background="#80000000">
            <Panel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsInEditMode"/>
                    <Binding Path="IsCreatingNew"/>
                </MultiBinding>
            </Panel.IsVisible>
            <views:CustomerFormView DataContext="{Binding CustomerFormViewModel}"/>
        </Panel>

        <Panel IsVisible="{Binding IsShowingDetail}" Background="#80000000">
            <views:CustomerDetailView DataContext="{Binding CustomerDetailViewModel}"/>
        </Panel>

    </Grid>
</UserControl>