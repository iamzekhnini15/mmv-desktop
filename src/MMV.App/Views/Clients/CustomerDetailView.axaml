<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:views="using:MMV.App.Views.Clients"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.CustomerDetailView"
             x:DataType="vm:CustomerDetailViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TabControl">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <ContentPresenter Name="PART_HeaderContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        
                        <Border Name="PART_Indicator"
                                Background="{DynamicResource AccentBrush}"
                                Height="2"
                                VerticalAlignment="Bottom"
                                IsVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="TabItem:selected /template/ Border#PART_Indicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <controls:BackButton Grid.Column="0"
                                     Command="{Binding BackCommand}"
                                     ButtonText="Retour"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"/>

                <Grid Grid.Column="1" ColumnDefinitions="Auto, *">
                    
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SurfaceLightBrush}" Margin="0,0,16,0">
                         <PathIcon Data="{StaticResource IconUser}" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Title}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   LetterSpacing="-0.5"
                                   TextTrimming="CharacterEllipsis"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Customer.Email, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <PathIcon Data="{StaticResource IconMail}" Width="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Customer.Email}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Customer.Phone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <PathIcon Data="{StaticResource IconPhone}" Width="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Customer.Phone}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="16" Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconCalendar}" Width="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Customer.CreatedAt, StringFormat='Depuis {0:dd/MM/yyyy}'}" 
                                       FontSize="11" 
                                       FontWeight="Medium" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconSales}" Width="14"/>
                        <TextBlock Text="Nouvelle Vente"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Padding="0" Background="{DynamicResource BackgroundBrush}">
                    <views:SaleFormView DataContext="{Binding SaleFormViewModel}"/>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPrescriptions}" Width="14"/>
                        <TextBlock Text="Ordonnances"/>
                    </StackPanel>
                </TabItem.Header>
                <views:CustomerPrescriptionsView DataContext="{Binding PrescriptionsViewModel}"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconUser}" Width="14"/>
                        <TextBlock Text="Informations"/>
                    </StackPanel>
                </TabItem.Header>
                <views:CustomerInfoView DataContext="{Binding CustomerInfoViewModel}"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconCard}" Width="14"/>
                        <TextBlock Text="Historique"/>
                    </StackPanel>
                </TabItem.Header>
                <views:CustomerPurchaseHistoryView DataContext="{Binding PurchaseHistoryViewModel}"/>
            </TabItem>

        </TabControl>

        <!-- Prescription Form Overlay (full page, covers header) -->
        <Panel Grid.Row="0" Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding PrescriptionsViewModel.IsInEditMode}">
            <ContentControl Content="{Binding PrescriptionsViewModel.FormViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:PrescriptionFormViewModel">
                        <views:PrescriptionFormView/>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Panel>

    </Grid>
</UserControl>