<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.SaleFormView"
             x:DataType="vm:SaleFormViewModel"
             Background="#1D1D1D">

    <UserControl.Styles>
        <!-- Styles pour les Sections -->
        <Style Selector="Border.SectionCard">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Labels -->
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Values (TextBlock) -->
        <Style Selector="TextBlock.ValueText">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#0071E3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- DataGrid -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>

        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="#0071E3"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Bouton Secondaire (Ajouter) -->
        <Style Selector="Button.SecondaryAction">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.SecondaryAction:pointerover">
            <Setter Property="BorderBrush" Value="#606060"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- En-tête simple -->
        <Border Grid.Row="0" Padding="32,24,32,10">
            <StackPanel Spacing="2">
                <TextBlock Text="Nouvelle Vente" FontSize="22" FontWeight="700" Foreground="#FFFFFF"/>
                <TextBlock Text="Sélectionnez des produits et finalisez la vente" FontSize="13" Foreground="#858585"/>
            </StackPanel>
        </Border>

        <!-- Contenu principal -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,0">
            <StackPanel Spacing="20">
                
                <!-- Section 1: Panier / Articles -->
                <Border Classes="SectionCard">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Panier" Classes="ValueText" FontSize="16"/>
                            <!-- ItemsCount retiré pour éviter l'erreur de binding -->
                            <TextBlock Grid.Column="1" Text="Articles" 
                                      FontSize="12" Foreground="#858585" VerticalAlignment="Center"/>
                        </Grid>

                        <DataGrid ItemsSource="{Binding SaleItems}" 
                                 AutoGenerateColumns="False"
                                 CanUserReorderColumns="False"
                                 CanUserResizeColumns="False"
                                 SelectionMode="Single">
                            <DataGrid.Columns>
                                <!-- On suppose que Product existe et a une propriété Reference -->
                                <DataGridTextColumn Header="Désignation" Binding="{Binding Product.Reference}" Width="2*"/>
                                <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="Prix Unitaire" Binding="{Binding UnitPrice, StringFormat='{}{0:F2} €'}" Width="100"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat='{}{0:F2} €'}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Ajouter un produit" 
                               Classes="SecondaryAction"
                               HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Section 2: Détails et Récapitulatif -->
                <Border Classes="SectionCard">
                    <Grid ColumnDefinitions="*,320">
                        <!-- Colonne Gauche: Détails -->
                        <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,20,0">
                            <TextBlock Text="Détails de la transaction" Classes="ValueText" FontSize="16"/>
                            
                            <!-- Méthode de Paiement -->
                            <StackPanel>
                                <TextBlock Text="Méthode de paiement" Classes="Label"/>
                                <ComboBox SelectedItem="{Binding PaymentMethod}" PlaceholderText="Sélectionner...">
                                    <ComboBoxItem>Espèces</ComboBoxItem>
                                    <ComboBoxItem>Carte Bancaire</ComboBoxItem>
                                    <ComboBoxItem>Chèque</ComboBoxItem>
                                    <ComboBoxItem>Virement</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- Remise -->
                            <StackPanel>
                                <TextBlock Text="Remise" Classes="Label"/>
                                <TextBox Text="{Binding DiscountAmount}" Watermark="0,00 €"/>
                            </StackPanel>

                            <!-- Notes -->
                            <StackPanel>
                                <TextBlock Text="Notes / Observations" Classes="Label"/>
                                <TextBox Text="{Binding Notes}" 
                                        Height="80"
                                        AcceptsReturn="True" 
                                        TextWrapping="Wrap"
                                        VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Colonne Droite: Récapitulatif (Totaux) -->
                        <Border Grid.Column="1" 
                               Background="#1F1F1F" 
                               CornerRadius="8" 
                               Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Récapitulatif" 
                                          FontSize="13" 
                                          FontWeight="600" 
                                          Foreground="#858585"
                                          Margin="0,0,0,10"/>
                                
                                <!-- Ligne Vide pour l'espacement si pas de TVA -->
                                <Border Height="1" Background="#333" Margin="0,8,0,8"/>

                                <!-- Remise -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                    <TextBlock Text="Remise" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='-{0:F2} €'}" 
                                              FontSize="14" Foreground="#FF453A" VerticalAlignment="Center" FontWeight="600"/>
                                </Grid>
                                
                                <Border Height="1" Background="#333" Margin="0,8,0,8"/>

                                <!-- Total TTC -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Net à payer" 
                                              FontSize="14" 
                                              FontWeight="600" 
                                              Foreground="#FFFFFF" 
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:F2} €'}" 
                                              FontSize="20" 
                                              FontWeight="700" 
                                              Foreground="#FFFFFF" 
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- Espace pour le scroll -->
                <Border Height="20"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Barre de boutons (Footer) -->
        <Border Grid.Row="2" 
               Padding="0,16,32,16" 
               BorderBrush="#333333" 
               BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                
                <Button Content="Annuler" 
                       Command="{Binding CancelCommand}"
                       Background="Transparent" 
                       Foreground="#E0E0E0" 
                       Padding="20,10" 
                       BorderThickness="0"
                       CornerRadius="6" 
                       Cursor="Hand"
                       FontSize="14">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Style>
                    </Button.Styles>
                </Button>
                
                <Button Content="Valider la vente" 
                       Command="{Binding SaveCommand}"
                       IsEnabled="{Binding !IsSaving}"
                       Background="#0071E3" 
                       Foreground="White" 
                       Padding="30,10" 
                       CornerRadius="6" 
                       Cursor="Hand"
                       FontSize="14"
                       FontWeight="600">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#005BB5"/>
                        </Style>
                        <Style Selector="Button:disabled">
                            <Setter Property="Background" Value="#404040"/>
                            <Setter Property="Foreground" Value="#808080"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>