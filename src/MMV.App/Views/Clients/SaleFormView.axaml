<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.SaleFormView"
             x:DataType="vm:SaleFormViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="DataGrid">
            <Setter Property="RowHeight" Value="36"/> <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*, 350"> <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="0,0,1,0">
            
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1" Padding="16,10">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconSales}" Width="14"/>
                        <TextBlock Text="Panier en cours" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="Secondary" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconPlus}" Width="10"/>
                            <TextBlock Text="Ajouter Article (F2)" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1" ItemsSource="{Binding SaleItems}" AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="RÉFÉRENCE" Binding="{Binding Product.Reference}" Width="2*" FontWeight="Medium"/>
                    <DataGridTextColumn Header="QTÉ" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="PRIX UNITAIRE" Binding="{Binding UnitPrice, StringFormat='{}{0:F2} €'}" Width="150" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPrice, StringFormat='{}{0:F2} €'}" Width="100" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0" Padding="16">
                <TextBlock Text="Aucun article scanne" IsVisible="{Binding !SaleItems.Count}" Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" FontSize="12"/>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,0">
            <Grid RowDefinitions="*, Auto">
                <ScrollViewer Grid.Row="0" Padding="20">
                    <StackPanel Spacing="24">
                        
                        <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="NET À PAYER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:F2} €'}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="16">
                            <TextBlock Text="RÈGLEMENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" LetterSpacing="1"/>
                            
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" ShowGridLines="False">
                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                    <TextBlock Text="Mode de paiement" Classes="label"/>
                                    <ComboBox SelectedItem="{Binding PaymentMethod}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem>Espèces</ComboBoxItem>
                                        <ComboBoxItem>Carte Bancaire</ComboBoxItem>
                                        <ComboBoxItem>Chèque</ComboBoxItem>
                                        <ComboBoxItem>Virement</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,12">
                                    <TextBlock Text="Remise (€)" Classes="label"/>
                                    <TextBox Text="{Binding DiscountAmount}" Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,12">
                                    <TextBlock Text="TVA (20%)" Classes="label"/>
                                    <TextBox Text="-" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0,6"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <TextBlock Text="Note interne" Classes="label"/>
                                <TextBox Text="{Binding Notes}" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Spacing="10" Margin="20,20,20,20">
                    <Button Command="{Binding SaveCommand}" IsEnabled="{Binding !IsSaving}" Classes="Primary" HorizontalAlignment="Stretch" Padding="0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconSales}" Width="16" Foreground="White"/>
                            <TextBlock Text="ENCAISSER" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}" Content="Annuler" Background="Transparent" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>