<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1600"
             x:Class="MMV.App.Views.Clients.CustomerInfoView"
             x:DataType="vm:CustomerInfoViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style Selector="Border.Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,10,0,20"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="0">
            <!-- Section Informations Client -->
            <Grid ColumnDefinitions="1*, 1, 1*" Margin="40,20">
                
                <StackPanel Grid.Column="0" Margin="0,0,40,0">
                    <TextBlock Text="ÉTAT CIVIL &amp; ADRESSE" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>
                    
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel>
                            <TextBlock Text="Prénom" Classes="FieldLabel"/>
                            <TextBlock Text="{Binding Customer.FirstName}" Classes="FieldValue" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Nom" Classes="FieldLabel"/>
                            <TextBlock Text="{Binding Customer.LastName}" Classes="FieldValue" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="Date de naissance" Classes="FieldLabel"/>
                        <TextBlock Text="{Binding Customer.BirthDate, StringFormat='{}{0:dd MMMM yyyy}'}" Classes="FieldValue"/>
                    </StackPanel>

                    <Border Classes="Separator"/>

                    <StackPanel>
                        <TextBlock Text="Adresse" Classes="FieldLabel"/>
                        <TextBlock Text="{Binding Customer.Address}" Classes="FieldValue"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="1*, 2*">
                        <StackPanel>
                            <TextBlock Text="Code Postal" Classes="FieldLabel"/>
                            <TextBlock Text="{Binding Customer.PostalCode}" Classes="FieldValue"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ville" Classes="FieldLabel"/>
                            <TextBlock Text="{Binding Customer.City}" Classes="FieldValue"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" Width="1" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" Margin="40,0,0,0">
                    <TextBlock Text="CONTACT &amp; ADMINISTRATIF" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel>
                            <TextBlock Text="Téléphone Mobile" Classes="FieldLabel"/>
                            <TextBlock Text="{Binding Customer.Phone}" Classes="FieldValue"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Email" Classes="FieldLabel"/>
                            <TextBlock Text="{Binding Customer.Email}" Classes="FieldValue" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Border Classes="Separator"/>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel>
                            <TextBlock Text="N° Sécurité Sociale" Classes="FieldLabel"/>
                            <TextBlock Text="{Binding Customer.SocialSecurityNumber}" Classes="FieldValue"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Mutuelle" Classes="FieldLabel"/>
                            <TextBlock Text="{Binding Customer.InsuranceName}" Classes="FieldValue"/>
                        </StackPanel>
                    </Grid>

                    <Border Classes="Separator"/>

                    <StackPanel>
                        <TextBlock Text="Notes internes" Classes="FieldLabel"/>
                        <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4" Padding="12">
                            <TextBlock Text="{Binding Customer.Notes}" FontSize="13" FontStyle="Italic" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Section Historique des Achats -->
            <Grid RowDefinitions="Auto, *" Margin="0,40,0,0">
                <Border Grid.Row="0" Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                    <StackPanel>
                        <TextBlock Text="Historique des Achats" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Toutes les transactions passées." FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Orders}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          BorderThickness="0"
                          RowHeight="44"
                          IsVisible="{Binding HasOrders}">
                    
                    <DataGrid.Styles>
                        <Style Selector="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                        <Style Selector="DataGridCell">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Styles>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                        <DataGridTextColumn Header="N° FACTURE" Binding="{Binding OrderNumber}" Width="*" FontWeight="Medium"/>
                        <DataGridTextColumn Header="STATUT" Binding="{Binding Status}" Width="150" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <DataGridTextColumn Header="MONTANT" Binding="{Binding TotalAmount, StringFormat='{}{0:F2} €'}" Width="120" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" Height="2" Background="Transparent"/>
                <TextBlock Grid.Row="1" Text="Aucune commande trouvée" IsVisible="{Binding !HasOrders}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,40,0,0"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>