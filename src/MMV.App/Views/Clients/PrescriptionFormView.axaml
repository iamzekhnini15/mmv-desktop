<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="MMV.App.Views.Clients.PrescriptionFormView"
             x:DataType="vm:PrescriptionFormViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="TextBox.OpticInput">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.OpticInput:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="#2D2D2D"/>
        </Style>

        <Style Selector="TextBox.TextInput">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:BackButton Grid.Column="0" Command="{Binding CancelCommand}" ButtonText="Annuler" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Nouvelle Prescription" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Saisie manuelle des données d'examen" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Enregistrer l'ordonnance" 
                        Command="{Binding SaveCommand}" 
                        IsEnabled="{Binding !IsSaving}"
                        Classes="Primary" Padding="24,10"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="40" Spacing="40" MaxWidth="1400" HorizontalAlignment="Stretch">
                
                <Grid ColumnDefinitions="1*, 40, 1*, 40, 1*">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="DATE D'ÉMISSION" Classes="SectionHeader"/>
                        <DatePicker SelectedDate="{Binding IssueDate}" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="MÉDECIN PRESCRIPTEUR" Classes="SectionHeader"/>
                        <TextBox Text="{Binding DoctorName}" Watermark="Dr. Nom Prénom" Classes="TextInput">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource IconUser}" Width="14" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Spacing="8">
                        <TextBlock Text="RÉFÉRENCE / N°" Classes="SectionHeader"/>
                        <TextBox Classes="TextInput" Watermark="Facultatif" />
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                <Grid ColumnDefinitions="1*, 40, 1*">
                    
                    <StackPanel Grid.Column="0" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentFadeBrush}">
                                <TextBlock Text="R" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                            </Border>
                            <TextBlock Text="ŒIL DROIT (OD)" Classes="SectionHeader" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentFadeBrush}" BorderThickness="2" CornerRadius="12" Padding="24">
                            <UniformGrid Columns="3" Rows="3">
                                <StackPanel Margin="0,0,12,20">
                                    <TextBlock Text="SPHÈRE" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OdSphere}" Classes="OpticInput" Watermark="±0.00"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,20">
                                    <TextBlock Text="CYLINDRE" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OdCylinder}" Classes="OpticInput" Watermark="±0.00"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="AXE" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OdAxis}" Classes="OpticInput" Watermark="0°"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="ADDITION" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OdAddition}" Classes="OpticInput" Foreground="{DynamicResource SuccessBrush}" Watermark="+0.00"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="PRISME" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OdPrismValue}" Classes="OpticInput" Watermark="0.00"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="BASE" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OdPrismBase}" Classes="OpticInput" Watermark="H/V/In/Out"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Stretch" Margin="19,40"/>

                    <StackPanel Grid.Column="2" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#33FF9500">
                                <TextBlock Text="L" FontWeight="Bold" Foreground="#FF9500" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                            </Border>
                            <TextBlock Text="ŒIL GAUCHE (OG)" Classes="SectionHeader" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="#33FF9500" BorderThickness="2" CornerRadius="12" Padding="24">
                            <UniformGrid Columns="3" Rows="3">
                                <StackPanel Margin="0,0,12,20">
                                    <TextBlock Text="SPHÈRE" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OgSphere}" Classes="OpticInput" Watermark="±0.00"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,20">
                                    <TextBlock Text="CYLINDRE" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OgCylinder}" Classes="OpticInput" Watermark="±0.00"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="AXE" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OgAxis}" Classes="OpticInput" Watermark="0°"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="ADDITION" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OgAddition}" Classes="OpticInput" Foreground="{DynamicResource SuccessBrush}" Watermark="+0.00"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="PRISME" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OgPrismValue}" Classes="OpticInput" Watermark="0.00"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="BASE" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding OgPrismBase}" Classes="OpticInput" Watermark="H/V/In/Out"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="12">
                    <TextBlock Text="OBSERVATIONS ET NOTES COMPLÉMENTAIRES" Classes="SectionHeader"/>
                    <TextBox Text="{Binding Notes}" 
                             Classes="TextInput"
                             Height="120" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             VerticalContentAlignment="Top"
                             Watermark="Précisez ici les particularités de l'examen, les recommandations de verres (progressifs, antireflet...), ou les pathologies signalées..."/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <PathIcon Data="M12,2 L2,22 H22 L12,2 Z M12,18 V20 M12,10 V16" Width="16" Foreground="{DynamicResource ErrorBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding IsSaving}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <ProgressBar IsIndeterminate="True" Classes="Circular" Width="60" Height="60"/>
                <TextBlock Text="Enregistrement de l'ordonnance..." Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>