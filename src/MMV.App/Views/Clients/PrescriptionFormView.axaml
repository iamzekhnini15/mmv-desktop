<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.PrescriptionFormView"
             x:DataType="vm:PrescriptionFormViewModel"
             Background="#1D1D1D">

    <UserControl.Styles>
        <!-- Styles communs -->
        <Style Selector="Border.SectionCard">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="TextBlock.ValueText">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#0071E3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- En-tête -->
        <Border Grid.Row="0" Padding="32,24,32,10">
            <StackPanel Spacing="2">
                <TextBlock Text="Nouvelle Ordonnance" FontSize="22" FontWeight="700" Foreground="#FFFFFF"/>
                <TextBlock Text="Saisissez les données de prescription" FontSize="13" Foreground="#858585"/>
            </StackPanel>
        </Border>

        <!-- Contenu principal -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,0">
            <StackPanel Spacing="20">
                
                <!-- Section Générales -->
                <Border Classes="SectionCard">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Infos Générales" Classes="ValueText" FontSize="16"/>
                        
                        <!-- Grille pour Date et Médecin (sur une même ligne) -->
                        <Grid ColumnDefinitions="*,16,*">
                            <!-- Date -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Date d'émission" Classes="Label"/>
                                <DatePicker SelectedDate="{Binding IssueDate}" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Médecin -->
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Médecin prescripteur" Classes="Label"/>
                                <TextBox Text="{Binding DoctorName}" Watermark="Nom du médecin..."/>
                            </StackPanel>
                        </Grid>

                        <!-- Séparateur visuel optionnel -->
                        <Border Height="1" Background="#333" Margin="0,4,0,8" IsVisible="False"/>

                        <!-- Notes (Pleine largeur en dessous) -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Notes" Classes="Label"/>
                            <TextBox Text="{Binding Notes}" 
                                    Height="80"
                                    AcceptsReturn="True" 
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section Yeux (Côte à côte) -->
                <Grid ColumnDefinitions="*,12,*">
                    
                    <!-- OEIL DROIT (OD) -->
                    <Border Grid.Column="0" Classes="SectionCard">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Œil Droit (OD)" Classes="ValueText" FontSize="16"/>
                            
                            <!-- MODIFICATION ICI : 6 colonnes au lieu de 5 -->
                            <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                                
                                <!-- Sphère -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Sphère" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OdSphere}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Cylindre -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,4,0">
                                    <TextBlock Text="Cylindre" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OdCylinder}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Axe -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,4,0">
                                    <TextBlock Text="Axe" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OdAxis}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Addition -->
                                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,4,0">
                                    <TextBlock Text="Addition" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OdAddition}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Prisme -->
                                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,4,0">
                                    <TextBlock Text="Prisme" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OdPrismValue}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Base (AJOUTÉ) -->
                                <StackPanel Grid.Row="0" Grid.Column="5" Margin="0,0,0,0">
                                    <TextBlock Text="Base" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OdPrismBase}" Padding="10,8"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- OEIL GAUCHE (OG) -->
                    <Border Grid.Column="2" Classes="SectionCard">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Œil Gauche (OG)" Classes="ValueText" FontSize="16"/>
                            
                            <!-- MODIFICATION ICI : 6 colonnes au lieu de 5 -->
                            <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                                
                                <!-- Sphère -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Sphère" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OgSphere}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Cylindre -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,4,0">
                                    <TextBlock Text="Cylindre" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OgCylinder}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Axe -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,4,0">
                                    <TextBlock Text="Axe" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OgAxis}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Addition -->
                                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,4,0">
                                    <TextBlock Text="Addition" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OgAddition}" Padding="10,8"/>
                                </StackPanel>
                                
                                <!-- Prisme -->
                                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,4,0">
                                    <TextBlock Text="Prisme" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OgPrismValue}" Padding="10,8"/>
                                </StackPanel>
                            
                                <!-- Base (AJOUTÉ) -->
                                <StackPanel Grid.Row="0" Grid.Column="5" Margin="0,0,0,0">
                                    <TextBlock Text="Base" Classes="Label" FontSize="11"/>
                                    <TextBox Text="{Binding OgPrismBase}" Padding="10,8"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Espace pour le scroll -->
                <Border Height="20"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Barre de boutons (Footer) -->
        <Border Grid.Row="2" 
               Padding="0,16,32,16" 
               BorderBrush="#333333" 
               BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                
                <Button Content="Annuler" 
                       Command="{Binding CancelCommand}"
                       Background="Transparent" 
                       Foreground="#E0E0E0" 
                       Padding="20,10" 
                       BorderThickness="0"
                       CornerRadius="6" 
                       Cursor="Hand"
                       FontSize="14">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Style>
                    </Button.Styles>
                </Button>
                
                <Button Content="Enregistrer l'ordonnance" 
                       Command="{Binding SaveCommand}"
                       IsEnabled="{Binding !IsSaving}"
                       Background="#0071E3" 
                       Foreground="White" 
                       Padding="30,10" 
                       CornerRadius="6" 
                       Cursor="Hand"
                       FontSize="14"
                       FontWeight="600">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#005BB5"/>
                        </Style>
                        <Style Selector="Button:disabled">
                            <Setter Property="Background" Value="#404040"/>
                            <Setter Property="Foreground" Value="#808080"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>