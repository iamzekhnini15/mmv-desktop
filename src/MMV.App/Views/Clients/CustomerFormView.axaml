<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.CustomerFormView"
             x:DataType="vm:CustomerFormViewModel"
             Background="#1D1D1D">

    <UserControl.Styles>
        <!-- Styles réutilisés -->
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#0071E3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Bouton Secondaire -->
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.SecondaryButton:pointerover">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- HEADER -->
        <Border Grid.Row="0" Padding="32,24,32,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <controls:BackButton Grid.Column="0"
                            Command="{Binding BackCommand}"
                            ButtonText="← Retour"
                            Margin="0,0,32,0"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Nouveau Client" 
                              FontSize="20" 
                              FontWeight="700" 
                              Foreground="#FFFFFF"/>
                    <TextBlock Text="Complétez les informations ci-dessous" 
                              FontSize="13" 
                              Foreground="#858585"/>
                </StackPanel>
                
                <Button Grid.Column="2" 
                        Content="Annuler" 
                        Command="{Binding CancelCommand}"
                        Classes="SecondaryButton"
                        FontSize="13"
                        FontWeight="500"
                        Margin="0,0,12,0"/>
                
                <Button Grid.Column="3" 
                        Content="Enregistrer" 
                        Command="{Binding SaveCommand}"
                        Background="#0071E3" 
                        Foreground="White" 
                        Padding="24,10" 
                        BorderThickness="0" 
                        CornerRadius="6" 
                        FontWeight="600"
                        FontSize="13"
                        Cursor="Hand"/>
            </Grid>
        </Border>
        
        <!-- CONTENU SCROLLABLE -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,0">
            <StackPanel Spacing="16">
                
                <!-- PREMIÈRE LIGNE: Info personnelle + Contact -->
                <Grid ColumnDefinitions="*,*">
                    
                    <!-- Section: Informations personnelles -->
                    <Border Grid.Column="0" Classes="Card" Margin="0,0,8,0">
                        <StackPanel Spacing="16">
                            <TextBlock Text="👤 Informations personnelles" 
                                      FontSize="15" 
                                      FontWeight="600" 
                                      Foreground="#FFFFFF" 
                                      Margin="0,0,0,8"/>
                            
                            <StackPanel Spacing="12">
                                <!-- Prénom -->
                                <StackPanel>
                                    <TextBlock Text="Prénom" Classes="Label"/>
                                    <TextBox Text="{Binding FirstName}" Watermark="Jean"/>
                                </StackPanel>
                                
                                <!-- Nom -->
                                <StackPanel>
                                    <TextBlock Text="Nom" Classes="Label"/>
                                    <TextBox Text="{Binding LastName}" Watermark="Dupont"/>
                                </StackPanel>
                                
                                <!-- Date de naissance -->
                                <StackPanel>
                                    <TextBlock Text="Date de naissance" Classes="Label"/>
                                    <DatePicker SelectedDate="{Binding BirthDate}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Contact -->
                    <Border Grid.Column="1" Classes="Card" Margin="8,0,0,0">
                        <StackPanel Spacing="16">
                            <TextBlock Text="📞 Contact" 
                                      FontSize="15" 
                                      FontWeight="600" 
                                      Foreground="#FFFFFF" 
                                      Margin="0,0,0,8"/>
                            
                            <StackPanel Spacing="12">
                                <!-- Email -->
                                <StackPanel>
                                    <TextBlock Text="Email" Classes="Label"/>
                                    <TextBox Text="{Binding Email}" Watermark="exemple@email.com"/>
                                </StackPanel>
                                
                                <!-- Téléphone -->
                                <StackPanel>
                                    <TextBlock Text="Téléphone" Classes="Label"/>
                                    <TextBox Text="{Binding Phone}" Watermark="06 12 34 56 78"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- DEUXIÈME LIGNE: Adresse + Sécurité sociale -->
                <Grid ColumnDefinitions="*,*">
                    
                    <!-- Section: Adresse -->
                    <Border Grid.Column="0" Classes="Card" Margin="0,0,8,0">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🏠 Adresse" 
                                      FontSize="15" 
                                      FontWeight="600" 
                                      Foreground="#FFFFFF" 
                                      Margin="0,0,0,8"/>
                            
                            <StackPanel Spacing="12">
                                <!-- Adresse -->
                                <StackPanel>
                                    <TextBlock Text="Adresse" Classes="Label"/>
                                    <TextBox Text="{Binding Address}" Watermark="Rue, numéro..."/>
                                </StackPanel>
                                
                                <!-- Ville et Code postal -->
                                <Grid ColumnDefinitions="2*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Ville" Classes="Label"/>
                                        <TextBox Text="{Binding City}" Watermark="Paris"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Code postal" Classes="Label"/>
                                        <TextBox Text="{Binding PostalCode}" Watermark="75000"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Sécurité sociale -->
                    <Border Grid.Column="1" Classes="Card" Margin="8,0,0,0">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🏥 Sécurité sociale" 
                                      FontSize="15" 
                                      FontWeight="600" 
                                      Foreground="#FFFFFF" 
                                      Margin="0,0,0,8"/>
                            
                            <StackPanel Spacing="12">
                                <!-- Numéro SS -->
                                <StackPanel>
                                    <TextBlock Text="Numéro de sécurité sociale" Classes="Label"/>
                                    <TextBox Text="{Binding SocialSecurityNumber}" Watermark="13 chiffres"/>
                                </StackPanel>
                                
                                <!-- Mutuelle -->
                                <StackPanel>
                                    <TextBlock Text="Mutuelle" Classes="Label"/>
                                    <TextBox Text="{Binding InsuranceName}" Watermark="Nom de l'organisme"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TROISIÈME LIGNE: Notes (pleine largeur) -->
                <Border Classes="Card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="📝 Notes" 
                                  FontSize="15" 
                                  FontWeight="600" 
                                  Foreground="#FFFFFF" 
                                  Margin="0,0,0,8"/>
                        
                        <TextBox Text="{Binding Notes}" 
                                Watermark="Informations supplémentaires..."
                                AcceptsReturn="True" 
                                TextWrapping="Wrap"
                                Height="80" 
                                VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        
        <!-- FOOTER -->
        <Border Grid.Row="2" Padding="32,12,32,12" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <TextBlock Text="💡 Tous les champs sont optionnels sauf le prénom et le nom" 
                      FontSize="12" 
                      Foreground="#858585"
                      VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>