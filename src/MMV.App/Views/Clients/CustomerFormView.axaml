<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.CustomerFormView"
             x:DataType="vm:CustomerFormViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <controls:BackButton Grid.Column="0"
                            Command="{Binding BackCommand}"
                            ButtonText="Retour à la liste"
                            Margin="0,0,32,0"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Nouveau Dossier Client" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button Content="Annuler" Padding="20,12" Cursor="Hand" CornerRadius="10" Command="{Binding CancelCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0"/>
                    <Button Content="Enregistrer le client" Command="{Binding SaveCommand}" Classes="Primary"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <ScrollViewer Grid.Row="1">
            <Grid ColumnDefinitions="1.5*, 1, 1*" Margin="40">
                
                <StackPanel Grid.Column="0" Spacing="40" Margin="0,0,40,0">
                    
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconUser}" Width="16" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="ÉTAT CIVIL" Classes="SectionTitle" Margin="0"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="*, 20, *" RowDefinitions="Auto, 20, Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                                <TextBlock Text="Prénom" Classes="label"/>
                                <TextBox Text="{Binding FirstName}" Watermark="ex: Jean" Classes="Input"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="8">
                                <TextBlock Text="Nom" Classes="label"/>
                                <TextBox Text="{Binding LastName}" Watermark="ex: Dupont" Classes="Input"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="8">
                                <TextBlock Text="Date de naissance" Classes="label"/>
                                <DatePicker SelectedDate="{Binding BirthDate}" HorizontalAlignment="Stretch" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconLocation}" Width="16" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="ADRESSE &amp; LOCALISATION" Classes="SectionTitle" Margin="0"/>
                        </StackPanel>

                        <Grid RowDefinitions="Auto, 16, Auto">
                            <StackPanel Grid.Row="0" Spacing="8">
                                <TextBlock Text="Adresse postale" Classes="label"/>
                                <TextBox Text="{Binding Address}" Watermark="Numéro et nom de rue" Classes="Input"/>
                            </StackPanel>

                            <Grid Grid.Row="2" ColumnDefinitions="*, 20, 2*">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Code Postal" Classes="label"/>
                                    <TextBox Text="{Binding PostalCode}" Watermark="75000" Classes="Input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="Ville" Classes="label"/>
                                    <TextBox Text="{Binding City}" Watermark="Paris" Classes="Input"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" Spacing="40" Margin="40,0,0,0">
                    
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconPhone}" Width="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="COORDONNÉES" Classes="SectionTitle" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0"/>
                        </StackPanel>

                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Téléphone mobile" Classes="label"/>
                                <TextBox Text="{Binding Phone}" Watermark="06 00 00 00 00" Classes="Input"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Adresse Email" Classes="label"/>
                                <TextBox Text="{Binding Email}" Watermark="client@email.com" Classes="Input"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconCard}" Width="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="COUVERTURE SOCIALE" Classes="SectionTitle" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0"/>
                        </StackPanel>

                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Numéro de Sécurité Sociale" Classes="label"/>
                                <TextBox Text="{Binding SocialSecurityNumber}" Watermark="13 ou 15 chiffres" Classes="Input"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Mutuelle / Organisme" Classes="label"/>
                                <TextBox Text="{Binding InsuranceName}" Watermark="Nom de la mutuelle" Classes="Input"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                         <TextBlock Text="NOTES &amp; OBSERVATIONS" Classes="SectionTitle" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Notes}" Classes="Input" AcceptsReturn="True" Height="100" TextWrapping="Wrap" Watermark="Ajouter une note interne..."/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

