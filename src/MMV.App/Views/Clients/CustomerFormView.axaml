<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.CustomerFormView"
             x:DataType="vm:CustomerFormViewModel"
             Background="#1D1D1D">

    <UserControl.Styles>
        <!-- Styles réutilisés -->
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#0071E3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Bouton Secondaire -->
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.SecondaryButton:pointerover">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- HEADER -->
        <Border Grid.Row="0" Padding="32,24,32,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" 
                        Content="← Retour" 
                        Command="{Binding CancelCommand}" 
                        Background="Transparent" 
                        Foreground="#E0E0E0" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        FontSize="14"
                        Padding="0"
                        VerticalAlignment="Center"
                        Margin="0,0,32,0"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Nouveau Client" 
                              FontSize="20" 
                              FontWeight="700" 
                              Foreground="#FFFFFF"/>
                    <TextBlock Text="Complétez les informations ci-dessous" 
                              FontSize="13" 
                              Foreground="#858585"/>
                </StackPanel>
                
                <Button Grid.Column="2" 
                        Content="Annuler" 
                        Command="{Binding CancelCommand}"
                        Classes="SecondaryButton"
                        FontSize="13"
                        FontWeight="500"
                        Margin="0,0,12,0"/>
                
                <Button Grid.Column="3" 
                        Content="Enregistrer" 
                        Command="{Binding SaveCommand}"
                        Background="#0071E3" 
                        Foreground="White" 
                        Padding="24,10" 
                        BorderThickness="0" 
                        CornerRadius="6" 
                        Cursor="Hand"
                        FontSize="13"
                        FontWeight="600">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#005BB5"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </Border>
        
        <!-- CONTENU SCROLLABLE -->
        <ScrollViewer Grid.Row="1" Padding="32,0,32,0">
            <Border Background="#252526" CornerRadius="12" Padding="24" HorizontalAlignment="Stretch">
                <StackPanel Spacing="20">
                    
                    <!-- Ligne 1: Prénom, Nom, Date de naissance -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                            <TextBlock Text="Prénom" Classes="Label"/>
                            <TextBox Text="{Binding FirstName}" Watermark="Jean"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,12,0">
                            <TextBlock Text="Nom" Classes="Label"/>
                            <TextBox Text="{Binding LastName}" Watermark="Dupont"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="0,0,0,0">
                            <TextBlock Text="Date de naissance" Classes="Label"/>
                            <DatePicker SelectedDate="{Binding BirthDate}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Ligne 2: Email, Téléphone -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                            <TextBlock Text="Email" Classes="Label"/>
                            <TextBox Text="{Binding Email}" Watermark="exemple@email.com"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,0,0">
                            <TextBlock Text="Téléphone" Classes="Label"/>
                            <TextBox Text="{Binding Phone}" Watermark="06 12 34 56 78"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Séparateur subtil -->
                    <Border Height="1" Background="#333333" Margin="0,8,0,8"/>

                    <!-- Ligne 3: Adresse -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Adresse" Classes="Label"/>
                        <TextBox Text="{Binding Address}" Watermark="Rue, numéro..."/>
                    </StackPanel>
                    
                    <!-- Ligne 4: Ville, Code postal -->
                    <Grid ColumnDefinitions="2*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                            <TextBlock Text="Ville" Classes="Label"/>
                            <TextBox Text="{Binding City}" Watermark="Paris"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,0,0">
                            <TextBlock Text="Code postal" Classes="Label"/>
                            <TextBox Text="{Binding PostalCode}" Watermark="75000"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Séparateur subtil -->
                    <Border Height="1" Background="#333333" Margin="0,8,0,8"/>

                    <!-- Ligne 5: Numéro SS, Mutuelle -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                            <TextBlock Text="Numéro de sécurité sociale" Classes="Label"/>
                            <TextBox Text="{Binding SocialSecurityNumber}" Watermark="13 chiffres"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,0,0">
                            <TextBlock Text="Mutuelle" Classes="Label"/>
                            <TextBox Text="{Binding InsuranceName}" Watermark="Nom de l'organisme"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Ligne 6: Notes -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notes" Classes="Label"/>
                        <TextBox Text="{Binding Notes}" 
                                Watermark="Informations supplémentaires..."
                                AcceptsReturn="True" 
                                TextWrapping="Wrap"
                                Height="100" 
                                VerticalContentAlignment="Top"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        
        <!-- FOOTER -->
        <Border Grid.Row="2" Padding="32,12,32,12" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                          Text="Les champs marqués d'un astérisque (*) sont obligatoires" 
                          FontSize="12" 
                          Foreground="#858585"
                          VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Formulaire non enregistré" 
                              FontSize="12" 
                              Foreground="#858585"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>