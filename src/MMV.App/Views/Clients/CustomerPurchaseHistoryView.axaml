<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.CustomerPurchaseHistoryView"
             x:DataType="vm:CustomerPurchaseHistoryViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Historique des Achats" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Toutes les transactions passées." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Orders}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0"
                  RowHeight="44">
            
            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,8"/>
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
                <DataGridTextColumn Header="DATE" Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                <DataGridTextColumn Header="N° FACTURE" Binding="{Binding OrderNumber}" Width="*" FontWeight="Medium"/>
                <DataGridTextColumn Header="STATUT" Binding="{Binding Status}" Width="150" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <DataGridTextColumn Header="MONTANT" Binding="{Binding TotalAmount, StringFormat='{}{0:F2} €'}" Width="120" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" Height="2" Background="Transparent"/>
        <TextBlock Grid.Row="1" Text="Aucune commande trouvée" IsVisible="{Binding !HasOrders}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}"/>
    </Grid>
</UserControl>
