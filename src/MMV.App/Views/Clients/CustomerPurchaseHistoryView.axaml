<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Clients.CustomerPurchaseHistoryView"
             x:DataType="vm:CustomerPurchaseHistoryViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Historique des Achats" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Toutes les ventes du client." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16" Spacing="12">
                <!-- Section Toutes les Ventes -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Ventes" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                    
                    <DataGrid ItemsSource="{Binding Sales}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderBrush}"
                              RowHeight="44"
                              Background="{DynamicResource SurfaceBrush}">
                        
                        <DataGrid.Styles>
                            <Style Selector="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,8"/>
                            </Style>
                            <Style Selector="DataGridCell">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Styles>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding SaleDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                            <DataGridTextColumn Header="N° VENTE" Binding="{Binding SaleNumber}" Width="*" FontWeight="Medium"/>
                            <DataGridTextColumn Header="STATUT" Binding="{Binding Status}" Width="130" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <DataGridTextColumn Header="LIVRAISON EST." Binding="{Binding EstimatedDelivery, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='-'}" Width="120" Foreground="{DynamicResource WarningBrush}"/>
                            <DataGridTextColumn Header="MONTANT" Binding="{Binding FinalAmount, StringFormat='{}{0:F2} €'}" Width="110" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <DataGridTextColumn Header="ACOMPTE" Binding="{Binding DepositAmount, StringFormat='{}{0:F2} €', TargetNullValue='-'}" Width="110" Foreground="{DynamicResource SuccessBrush}"/>
                            <DataGridTextColumn Header="RESTANT" Binding="{Binding RemainingAmount, StringFormat='{}{0:F2} €', TargetNullValue='-'}" Width="110" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Aucune vente trouvée" 
                               IsVisible="{Binding !HasSales}" 
                               HorizontalAlignment="Center" 
                               Foreground="{DynamicResource TextDisabledBrush}" 
                               FontStyle="Italic"
                               Margin="0,12"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" Height="2" Background="Transparent"/>
    </Grid>
</UserControl>
