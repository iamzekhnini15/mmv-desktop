<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="420"
             x:Class="MMV.App.Views.DatabaseBlockedView"
             x:DataType="vm:DatabaseBlockedViewModel">

    <!-- P4-6C (DP-4) : écran de blocage minimal — constat, action attendue, Quitter. Aucune autre interaction. -->
    <Border Padding="40">
        <StackPanel Spacing="20" MaxWidth="640" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <SelectableTextBlock Text="{Binding Message}" FontSize="15" TextWrapping="Wrap"/>
            <SelectableTextBlock Text="{Binding Action}" FontSize="15" TextWrapping="Wrap"/>
            <Button Content="Quitter" Command="{Binding QuitCommand}" IsDefault="True" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</UserControl>
