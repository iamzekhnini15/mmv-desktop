<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:converters="using:MMV.App.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.InventoryView"
             x:DataType="vm:InventoryViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="Border.InventoryRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="20,12"/>
        </Style>
        <Style Selector="Border.InventoryRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
        </Style>

        <Style Selector="TextBlock.ColHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.CountInput">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.CountInput:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <TextBlock Text="Inventaire Physique" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconUser}" Width="10" Height="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalItems}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="80" Height="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBox Classes="FilterInput"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 Watermark="Rechercher..."
                                 Width="250"/>
                        <PathIcon Data="{StaticResource IconSearch}" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center"
                           FontSize="12"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Juste" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource ErrorBrush}"/>
                        <TextBlock Text="Écart" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" RowDefinitions="Auto, *">

            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid ColumnDefinitions="120, 3*, 120, 120, 100, 80">
                    <TextBlock Grid.Column="0" Text="RÉFÉRENCE" Classes="ColHeader"/>
                    <TextBlock Grid.Column="1" Text="DÉSIGNATION PRODUIT" Classes="ColHeader"/>
                    <TextBlock Grid.Column="2" Text="STOCK THÉO." Classes="ColHeader" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="STOCK RÉEL" Classes="ColHeader" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="ÉCART" Classes="ColHeader" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="VALIDER" Classes="ColHeader" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceBrush}" Padding="20" IsVisible="{Binding IsLoading}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <controls:LoadingSpinner />
                            <TextBlock Text="Chargement de l'inventaire..." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="InventoryRow">
                                    <Grid ColumnDefinitions="120, 3*, 120, 120, 100, 80">

                                        <TextBlock Grid.Column="0" Text="{Binding Product.Reference}"
                                                   VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Product.Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Product.Category}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding TheoreticalStock}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBox Grid.Column="3"
                                                 Classes="CountInput"
                                                 Text="{Binding CountedStock, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="80"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="4" Padding="8,2" MinWidth="40">
                                            <TextBlock Text="{Binding Difference, StringFormat='{}{0:+0;-0}'}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{Binding Difference, Converter={x:Static converters:DifferenceColorConverter.Instance}}"/>
                                        </Border>

                                        <Button Grid.Column="5"
                                                Classes="Primary"
                                                Padding="8"
                                                Width="32" Height="32"
                                                CornerRadius="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="ConfirmButton_Click"
                                                Tag="{Binding}"
                                                IsVisible="{Binding CanConfirm}"
                                                ToolTip.Tip="Valider et corriger le stock">
                                            <PathIcon Data="{StaticResource IconCheck}" Width="12" Foreground="White"/>
                                        </Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding FilteredItems.Count, Converter={x:Static ObjectConverters.IsNull}}"
                                HorizontalAlignment="Center" Margin="0,100" Spacing="15" Opacity="0.5">
                        <PathIcon Data="{StaticResource IconSearch}" Width="48" Height="48" Foreground="{DynamicResource TextDisabledBrush}"/>
                        <TextBlock Text="Aucun produit trouvé dans l'inventaire" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>