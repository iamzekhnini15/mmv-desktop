<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMV.App.ViewModels"
             x:Class="MMV.App.Views.UsersView"
             x:DataType="vm:UsersViewModel"
             Padding="0">

    <Grid>
        <!-- Liste des utilisateurs -->
        <Border IsVisible="{Binding ShowList}" Padding="0">
            <Grid RowDefinitions="Auto, Auto, *, Auto">

                <!-- En-tête -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Gestion des Utilisateurs" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Gérez les comptes et les accès de votre équipe" Opacity="0.6" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ Nouvel utilisateur"
                            Command="{Binding ListViewModel.CreateCommand}"
                            Classes="Primary"
                            Padding="16,10" VerticalAlignment="Center"/>
                </Grid>

                <!-- Barre de recherche et filtres -->
                <Grid Grid.Row="1" ColumnDefinitions="*, 12, Auto, 12, Auto" Margin="0,0,0,16">
                    <TextBox Grid.Column="0"
                             Text="{Binding ListViewModel.SearchText}"
                             Watermark="Rechercher un utilisateur..."
                             Padding="12,10"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding ListViewModel.RoleFilters}"
                              SelectedItem="{Binding ListViewModel.SelectedRoleFilter}"
                              MinWidth="140"/>
                    <CheckBox Grid.Column="4"
                              IsChecked="{Binding ListViewModel.ShowActiveOnly}"
                              Content="Actifs uniquement"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Message d'erreur -->
                <Border Grid.Row="2"
                        IsVisible="{Binding ListViewModel.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#33FF453A" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ListViewModel.ErrorMessage}" Foreground="#FF453A"/>
                </Border>

                <!-- Tableau des utilisateurs -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" ClipToBounds="True">
                    <Grid RowDefinitions="Auto, *">
                        <!-- En-tête tableau -->
                        <Grid Grid.Row="0" ColumnDefinitions="3*, 2*, 2*, 1.5*, 1*, Auto"
                              Background="{DynamicResource SurfaceLightBrush}" Margin="0" Height="42">
                            <TextBlock Grid.Column="0" Text="Utilisateur" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Prénom" FontWeight="SemiBold" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Nom" FontWeight="SemiBold" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Rôle" FontWeight="SemiBold" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Statut" FontWeight="SemiBold" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Actions" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Lignes -->
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding ListViewModel.FilteredUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="3*, 2*, 2*, 1.5*, 1*, Auto"
                                                  Height="52" Background="Transparent">
                                                <!-- Avatar + Username -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <Border Width="32" Height="32" CornerRadius="16"
                                                            Background="{DynamicResource AccentFadeBrush}">
                                                        <TextBlock Text="{Binding Username[0]}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontWeight="Bold" FontSize="13"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Username}" VerticalAlignment="Center" FontWeight="Medium"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FirstName}" VerticalAlignment="Center" Opacity="0.85"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LastName}" VerticalAlignment="Center" Opacity="0.85"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Role}" VerticalAlignment="Center" Opacity="0.75" FontSize="12"/>
                                                <!-- Badge statut -->
                                                <Border Grid.Column="4" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Background="{DynamicResource AccentFadeBrush}">
                                                    <TextBlock FontSize="11" FontWeight="Medium" Text="{Binding IsActive}"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                <!-- Actions -->
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Button Content="Modifier"
                                                            Command="{Binding $parent[ItemsControl].((vm:UsersViewModel)DataContext).ListViewModel.EditCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" FontSize="12"/>
                                                    <Button Content="Activer/Désactiver"
                                                            Command="{Binding $parent[ItemsControl].((vm:UsersViewModel)DataContext).ListViewModel.ToggleActiveCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Pagination -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto, *, Auto" Margin="0,12,0,0">
                    <Button Grid.Column="0" Content="← Précédent"
                            Command="{Binding ListViewModel.PreviousPageCommand}"
                            Padding="10,6"/>
                    <TextBlock Grid.Column="1" Text="{Binding ListViewModel.PageInfo}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.7" FontSize="13"/>
                    <Button Grid.Column="2" Content="Suivant →"
                            Command="{Binding ListViewModel.NextPageCommand}"
                            Padding="10,6"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Formulaire (overlay) -->
        <Border IsVisible="{Binding !ShowList}" Padding="0">
            <Grid RowDefinitions="Auto, *">
                <!-- Titre formulaire -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,24">
                    <Button Grid.Column="0" Content="← Retour"
                            Command="{Binding FormViewModel.CancelCommand}"
                            Padding="10,8" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding FormViewModel.FormTitle}"
                               FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <!-- Champs du formulaire -->
                <ScrollViewer Grid.Row="1">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="24" MaxWidth="600" HorizontalAlignment="Left">
                        <StackPanel Spacing="16">

                            <Grid ColumnDefinitions="*, 12, *">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Prénom *" FontSize="12" Opacity="0.7"/>
                                    <TextBox Text="{Binding FormViewModel.FirstName}" Watermark="Prénom"/>
                                    <TextBlock Text="{Binding FormViewModel.FirstNameError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                               IsVisible="{Binding FormViewModel.FirstNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Nom *" FontSize="12" Opacity="0.7"/>
                                    <TextBox Text="{Binding FormViewModel.LastName}" Watermark="Nom"/>
                                    <TextBlock Text="{Binding FormViewModel.LastNameError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                               IsVisible="{Binding FormViewModel.LastNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Nom d'utilisateur *" FontSize="12" Opacity="0.7"/>
                                <TextBox Text="{Binding FormViewModel.Username}" Watermark="nom.utilisateur"/>
                                <TextBlock Text="{Binding FormViewModel.UsernameError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                           IsVisible="{Binding FormViewModel.UsernameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Rôle *" FontSize="12" Opacity="0.7"/>
                                <ComboBox ItemsSource="{Binding FormViewModel.AvailableRoles}"
                                          SelectedItem="{Binding FormViewModel.SelectedRole}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding FormViewModel.IsPasswordRequired}">
                                <TextBlock Text="Mot de passe *" FontSize="12" Opacity="0.7"/>
                                <TextBox Text="{Binding FormViewModel.Password}"
                                         PasswordChar="•" Watermark="Mot de passe"/>
                                <TextBlock Text="{Binding FormViewModel.PasswordError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                           IsVisible="{Binding FormViewModel.PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding FormViewModel.IsPasswordRequired}">
                                <TextBlock Text="Confirmer le mot de passe *" FontSize="12" Opacity="0.7"/>
                                <TextBox Text="{Binding FormViewModel.ConfirmPassword}"
                                         PasswordChar="•" Watermark="Confirmer le mot de passe"/>
                                <TextBlock Text="{Binding FormViewModel.ConfirmPasswordError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                           IsVisible="{Binding FormViewModel.ConfirmPasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding FormViewModel.IsActive}" Content="Compte actif"/>

                            <!-- Message d'erreur global -->
                            <Border IsVisible="{Binding FormViewModel.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="#33FF453A" CornerRadius="6" Padding="12,8">
                                <TextBlock Text="{Binding FormViewModel.ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Boutons -->
                            <Grid ColumnDefinitions="*, 12, Auto, 12, Auto" Margin="0,8,0,0">
                                <TextBlock Grid.Column="0"/>
                                <Button Grid.Column="2" Content="Annuler"
                                        Command="{Binding FormViewModel.CancelCommand}"
                                        Padding="14,10"/>
                                <Button Grid.Column="4" Content="Enregistrer"
                                        Command="{Binding FormViewModel.SaveCommand}"
                                        Classes="Primary"
                                        Padding="14,10"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
