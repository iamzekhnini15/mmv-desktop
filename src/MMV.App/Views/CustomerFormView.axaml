<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MMV.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="800"
        x:Class="MMV.App.Views.CustomerFormView"
        x:DataType="vm:CustomerFormViewModel"
        Title="{Binding Title}"
        Width="700" Height="800"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.png">

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        
        <Style Selector="TextBlock.ErrorText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#F9F9FB"/>
            <Setter Property="BorderBrush" Value="#D5D5D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style Selector="TextBox:error">
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- En-tête -->
        <Border Grid.Row="0" Background="#0071E3" Padding="24,20">
            <StackPanel>
                <TextBlock Text="{Binding Title}" 
                          FontSize="22" 
                          FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock Text="Remplissez les informations du client" 
                          FontSize="14" 
                          Foreground="White" 
                          Opacity="0.9" 
                          Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Formulaire -->
        <ScrollViewer Grid.Row="1" Padding="24,20">
            <StackPanel Spacing="20">
                
                <!-- Section Informations personnelles -->
                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="📋 Informations personnelles" 
                                  Classes="Heading3" 
                                  Margin="0,0,0,8"/>
                        
                        <!-- Prénom -->
                        <StackPanel>
                            <TextBlock Text="Prénom *" Classes="FieldLabel"/>
                            <TextBox Text="{Binding FirstName}" 
                                    Watermark="Entrez le prénom"
                                    IsEnabled="{Binding !IsSaving}"/>
                            <TextBlock Text="{Binding FirstNameError}" 
                                      Classes="ErrorText"
                                      IsVisible="{Binding FirstNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        
                        <!-- Nom -->
                        <StackPanel>
                            <TextBlock Text="Nom *" Classes="FieldLabel"/>
                            <TextBox Text="{Binding LastName}" 
                                    Watermark="Entrez le nom"
                                    IsEnabled="{Binding !IsSaving}"/>
                            <TextBlock Text="{Binding LastNameError}" 
                                      Classes="ErrorText"
                                      IsVisible="{Binding LastNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        
                        <!-- Date de naissance -->
                        <StackPanel>
                            <TextBlock Text="Date de naissance" Classes="FieldLabel"/>
                            <DatePicker SelectedDate="{Binding BirthDate}"
                                       IsEnabled="{Binding !IsSaving}"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Section Contact -->
                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="📞 Coordonnées" 
                                  Classes="Heading3" 
                                  Margin="0,0,0,8"/>
                        
                        <!-- Email -->
                        <StackPanel>
                            <TextBlock Text="Email" Classes="FieldLabel"/>
                            <TextBox Text="{Binding Email}" 
                                    Watermark="exemple@email.com"
                                    IsEnabled="{Binding !IsSaving}"/>
                            <TextBlock Text="{Binding EmailError}" 
                                      Classes="ErrorText"
                                      IsVisible="{Binding EmailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        
                        <!-- Téléphone -->
                        <StackPanel>
                            <TextBlock Text="Téléphone" Classes="FieldLabel"/>
                            <TextBox Text="{Binding Phone}" 
                                    Watermark="0123456789"
                                    IsEnabled="{Binding !IsSaving}"/>
                            <TextBlock Text="{Binding PhoneError}" 
                                      Classes="ErrorText"
                                      IsVisible="{Binding PhoneError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Section Adresse -->
                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🏠 Adresse" 
                                  Classes="Heading3" 
                                  Margin="0,0,0,8"/>
                        
                        <!-- Adresse -->
                        <StackPanel>
                            <TextBlock Text="Adresse" Classes="FieldLabel"/>
                            <TextBox Text="{Binding Address}" 
                                    Watermark="Numéro et nom de rue"
                                    IsEnabled="{Binding !IsSaving}"/>
                        </StackPanel>
                        
                        <!-- Ville et Code postal -->
                        <Grid ColumnDefinitions="2*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ville" Classes="FieldLabel"/>
                                <TextBox Text="{Binding City}" 
                                        Watermark="Ville"
                                        IsEnabled="{Binding !IsSaving}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Code postal" Classes="FieldLabel"/>
                                <TextBox Text="{Binding PostalCode}" 
                                        Watermark="00000"
                                        IsEnabled="{Binding !IsSaving}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Section Informations médicales -->
                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🏥 Informations médicales" 
                                  Classes="Heading3" 
                                  Margin="0,0,0,8"/>
                        
                        <!-- Numéro de sécurité sociale -->
                        <StackPanel>
                            <TextBlock Text="Numéro de sécurité sociale" Classes="FieldLabel"/>
                            <TextBox Text="{Binding SocialSecurityNumber}" 
                                    Watermark="1234567890123"
                                    IsEnabled="{Binding !IsSaving}"/>
                        </StackPanel>
                        
                        <!-- Mutuelle -->
                        <StackPanel>
                            <TextBlock Text="Mutuelle / Assurance" Classes="FieldLabel"/>
                            <TextBox Text="{Binding InsuranceName}" 
                                    Watermark="Nom de la mutuelle"
                                    IsEnabled="{Binding !IsSaving}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Section Notes -->
                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="📝 Notes" 
                                  Classes="Heading3" 
                                  Margin="0,0,0,8"/>
                        
                        <TextBox Text="{Binding Notes}" 
                                Watermark="Notes diverses concernant le client..."
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Height="100"
                                IsEnabled="{Binding !IsSaving}"/>
                    </StackPanel>
                </Border>
                
                <!-- Message d'erreur global -->
                <Border Background="#FEF5F5" 
                       BorderBrush="#E74C3C" 
                       BorderThickness="1" 
                       CornerRadius="8" 
                       Padding="16"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="⚠️" FontSize="18"/>
                        <TextBlock Text="{Binding ErrorMessage}" 
                                  Foreground="#E74C3C" 
                                  TextWrapping="Wrap"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Pied de page avec boutons -->
        <Border Grid.Row="2" 
               Background="#F5F5F7" 
               BorderBrush="#D5D5D7" 
               BorderThickness="0,1,0,0" 
               Padding="24,16">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Indicateur de chargement -->
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal" 
                           Spacing="12" 
                           VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                IsVisible="{Binding IsSaving}"
                                Width="150"
                                Height="3"
                                Foreground="#0071E3"/>
                    <TextBlock Text="Enregistrement en cours..." 
                              IsVisible="{Binding IsSaving}"
                              Classes="SecondaryText"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Boutons -->
                <Button Grid.Column="1" 
                       Content="Annuler"
                       Command="{Binding CancelCommand}"
                       Background="#F5F5F7"
                       Foreground="#1D1D1F"
                       BorderBrush="#D5D5D7"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="24,12"
                       Margin="0,0,12,0"
                       FontWeight="600"
                       FontSize="14"/>
                
                <Button Grid.Column="2" 
                       Content="💾 Enregistrer"
                       Command="{Binding SaveCommand}"
                       Classes="PrimaryButton"
                       Padding="24,12"
                       FontWeight="600"
                       FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</Window>
