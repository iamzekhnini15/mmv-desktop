<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:MMV.App.ViewModels"
            mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
            x:Class="MMV.App.Views.LoginView"
            x:DataType="vm:LoginViewModel"
            Background="#1D1D1D">
    
    <!-- Layout: Image (gauche) + Formulaire (droite) - Dark Mode Apple -->
    <Grid ColumnDefinitions="1*,1*" Background="#1D1D1D">
        
        <!-- Section gauche: Marque + Message -->
        <Border Grid.Column="0" Background="#2D2D2D" Padding="60" BorderBrush="#424245" BorderThickness="0,0,1,0">
            <StackPanel Spacing="32" VerticalAlignment="Center">
                <!-- Logo -->
                <TextBlock Text="👓" FontSize="80" HorizontalAlignment="Center"/>
                
                <!-- Titre principal -->
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="ManageMyVision" 
                              FontSize="36"
                              FontWeight="700"
                              Foreground="#FFFFFF"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Gestion Optique Professionnelle" 
                              FontSize="14"
                              Foreground="#A1A1A6"
                              HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Description -->
                <Border Background="#3A3A3C" CornerRadius="12" Padding="20" Margin="0,20,0,0" BorderBrush="#424245" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="✓ Gestion Clients" FontSize="14" FontWeight="600" Foreground="#FFFFFF"/>
                            <TextBlock Text="Référencez et suivez vos clients" FontSize="12" Foreground="#A1A1A6"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="4">
                            <TextBlock Text="✓ Stock &amp; Inventaire" FontSize="14" FontWeight="600" Foreground="#FFFFFF"/>
                            <TextBlock Text="Gérez votre inventaire en temps réel" FontSize="12" Foreground="#A1A1A6"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="4">
                            <TextBlock Text="✓ Commandes &amp; Ventes" FontSize="14" FontWeight="600" Foreground="#FFFFFF"/>
                            <TextBlock Text="Ordonnances et point de vente intégrés" FontSize="12" Foreground="#A1A1A6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Section droite: Formulaire de connexion -->
        <Border Grid.Column="1" Background="#1D1D1D">
            <StackPanel Margin="60,40" Spacing="24" VerticalAlignment="Center">
                
                <!-- En-tête du formulaire -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Bienvenue" FontSize="28" FontWeight="700" Foreground="#FFFFFF"/>
                    <TextBlock Text="Connectez-vous à votre compte" FontSize="14" Foreground="#A1A1A6"/>
                </StackPanel>

                <!-- Formulaire -->
                <StackPanel Spacing="16">
                    
                    <!-- Champ Utilisateur -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Identifiant" 
                                  FontSize="13"
                                  FontWeight="600"
                                  Foreground="#FFFFFF"/>
                        <TextBox x:Name="UsernameBox"
                                Text="{Binding Username}"
                                Watermark="Nom d'utilisateur"
                                FontSize="14"
                                Padding="14,12"
                                Foreground="#FFFFFF"
                                Background="#2D2D2D"
                                BorderBrush="#424245"
                                BorderThickness="1"
                                CornerRadius="8"/>
                    </StackPanel>

                    <!-- Champ Mot de passe -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Mot de passe" 
                                  FontSize="13"
                                  FontWeight="600"
                                  Foreground="#FFFFFF"/>
                        <TextBox x:Name="PasswordBox"
                                PasswordChar="•"
                                Watermark="Mot de passe"
                                FontSize="14"
                                Padding="14,12"
                                Foreground="#FFFFFF"
                                Background="#2D2D2D"
                                BorderBrush="#424245"
                                BorderThickness="1"
                                CornerRadius="8"/>
                    </StackPanel>

                    <!-- Message d'erreur -->
                    <Border Background="#3A1010" 
                           CornerRadius="8" 
                           Padding="14"
                           IsVisible="{Binding LoginError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           BorderBrush="#652020"
                           BorderThickness="1">
                        <TextBlock Text="{Binding LoginError}" 
                                  Foreground="#FF3B30" 
                                  TextWrapping="Wrap"
                                  FontSize="13"/>
                    </Border>

                    <!-- Bouton de connexion -->
                    <Button x:Name="LoginButton"
                           Content="Se connecter"
                           Command="{Binding LoginCommand}"
                           Classes="PrimaryButton"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           IsEnabled="{Binding !IsLoggingIn}"
                           Margin="0,8,0,0"
                           FontSize="15"
                           FontWeight="600"
                           Padding="0,14"/>

                    <!-- Indicateur de chargement -->
                    <ProgressBar IsIndeterminate="True"
                                IsVisible="{Binding IsLoggingIn}"
                                Height="2"
                                Foreground="#0A84FF"
                                Background="#2D2D2D"
                                CornerRadius="1"/>
                </StackPanel>

                <!-- Info de connexion (DEMO) -->
                <Border Background="#3A3A3C" 
                       CornerRadius="8" 
                       Padding="14"
                       Margin="0,12,0,0"
                       BorderBrush="#424245"
                       BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Identifiant de démo" 
                                  FontWeight="600" 
                                  Foreground="#FFFFFF"
                                  FontSize="13"/>
                        <TextBlock Text="Utilisateur: admin | Mot de passe: admin" 
                                  FontSize="12" 
                                  Foreground="#A1A1A6"
                                  FontFamily="monospace"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
