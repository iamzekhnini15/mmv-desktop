<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MMV.App.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <Grid ColumnDefinitions="1.2*, 1*">

        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto,*" Margin="60">

                <StackPanel Grid.Row="1" Spacing="20" HorizontalAlignment="Center">
                    <Grid HorizontalAlignment="Center">
                        <Border Width="120" Height="120" CornerRadius="60" Background="{DynamicResource AccentFadeBrush}" Opacity="0.5"/>
                        <PathIcon Data="{StaticResource IconGlasses}" Width="60" Height="60" Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>

                    <StackPanel Spacing="5">
                        <TextBlock Text="ManageMyVision" Classes="h1" FontSize="32" HorizontalAlignment="Center" Margin="0"/>
                        <TextBlock Text="La référence pour les opticiens." FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" FontWeight="Normal"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Spacing="15" Opacity="0.8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="M20 6L9 17L4 12" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Gestion complète des stocks" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="M20 6L9 17L4 12" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Suivi des ordonnances clients" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="M20 6L9 17L4 12" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Rapports de ventes détaillés" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto,*" Margin="80,0">

            <StackPanel Grid.Row="1" Spacing="24">

                <StackPanel Spacing="8">
                    <TextBlock Text="Bienvenue," FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Veuillez entrer vos identifiants pour continuer." Classes="caption" FontSize="14"/>
                </StackPanel>

                <StackPanel Spacing="16">

                    <StackPanel Spacing="8">
                        <TextBlock Text="Identifiant" Classes="label"/>
                        <TextBox Text="{Binding Username}"
                                 Watermark="ex: admin"
                                 Classes="Input"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Mot de passe" Classes="label"/>
                        <TextBox Text="{Binding Password}"
                                 PasswordChar="•"
                                 Watermark="••••••••"
                                 Classes="Input"
                                 RevealPassword="false"/>
                </StackPanel>

                    <TextBlock Text="Mot de passe oublié ?"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="12"
                               Cursor="Hand"
                               HorizontalAlignment="Right"
                               TextDecorations="Underline"/>
                </StackPanel>

                <Border Background="#26FF453A"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource SmallCornerRadius}"
                        Padding="12"
                        IsVisible="{Binding LoginError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Foreground="{DynamicResource ErrorBrush}"
                                  Width="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LoginError}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,0"
                                   FontSize="13"/>
                    </Grid>
                </Border>

                <StackPanel Spacing="12" Margin="0,10,0,0">
                    <Button Classes="Primary"
                            Content="Se connecter"
                            Command="{Binding LoginCommand}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding !IsLoggingIn}"/>

                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsLoggingIn}"
                                 Height="2"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="Transparent"/>
                </StackPanel>

                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource SmallCornerRadius}"
                        Padding="12"
                        Margin="0,20,0,0"
                        Background="{DynamicResource SurfaceLightBrush}"
                        Opacity="0.7">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Mode Démonstration" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="User: admin / Pass: admin" FontSize="11" FontFamily="Consolas, Monospace" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>