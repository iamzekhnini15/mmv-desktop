<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:converters="using:MMV.App.Converters"
             xmlns:views="using:MMV.App.Views.Products"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Products.ProductDetailView"
             x:DataType="vm:ProductDetailViewModel"
             Background="#1D1D1D">

    <UserControl.Styles>
        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="#0071E3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.DangerButton">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBlock.Value">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="600"/>
        </Style>

        <!-- Badge de date -->
        <Style Selector="Border.DateBadge">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Border Padding="32,24,32,24">

        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">

            <controls:BackButton Grid.Column="0"
                        Command="{Binding BackCommand}"
                        ButtonText="← Retour"
                        Margin="0,0,32,0"/>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding Title}"
                           FontSize="20"
                           FontWeight="700"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="{Binding Product.Reference}"
                           FontSize="12"
                           Foreground="#858585"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Modifier"
                        Command="{Binding EditCommand}"
                        Classes="PrimaryButton"/>
                <Button Content="Supprimer"
                        Command="{Binding DeleteCommand}"
                        Classes="DangerButton"/>
            </StackPanel>
        </Grid>

        <!-- Content: TabControl with Informations and Historique -->
        <TabControl Grid.Row="1">
            <TabControl.Styles>
                <!-- Style Apple pour la barre d'onglets -->
                <Style Selector="TabControl">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/> 
                </Style>

                <!-- Conteneur de l'en-tête des onglets (TabStrip) -->
                <Style Selector="TabControl > TabControl.ItemsPanel > ItemsPanelTemplate > StackPanel">
                    <Setter Property="Margin" Value="0,0,0,0"/>
                    <Setter Property="Spacing" Value="24"/>
                </Style>

                <!-- Style de base de l'onglet -->
                <Style Selector="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="12,6,12,10"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="500"/>
                    <Setter Property="Foreground" Value="#858585"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="PART_IndicatorBorder" 
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                                
                                <ContentPresenter Name="PART_HeaderContentPresenter"
                                                Content="{TemplateBinding Header}"
                                                TextElement.FontSize="{TemplateBinding FontSize}"
                                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>

                <!-- État : Sélectionné (Active) -->
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Style>

                <!-- L'indicateur visuel (le trait bleu Apple) qui apparaît quand sélectionné -->
                <Style Selector="TabItem:selected > Border#PART_IndicatorBorder">
                    <Setter Property="BorderBrush" Value="#0071E3"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                </Style>

                <!-- Effet de survol subtil -->
                <Style Selector="TabItem:pointerover > Border#PART_IndicatorBorder">
                    <Setter Property="Background" Value="#2D2D2D"/>
                </Style>
            </TabControl.Styles>

            <TabItem Header="Informations">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="0,12" Background="Transparent">
                    <StackPanel Spacing="12">
                        <Border Classes="Card">
                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,16,12">
                                    <TextBlock Text="Nom" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.Name}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="0,0,16,12">
                                    <TextBlock Text="Catégorie" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.Category}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="Fournisseur" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.Supplier.Name}" Classes="Value"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                                    <TextBlock Text="Date d'entrée" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.EntryDate, StringFormat='{}{0:dd/MM/yyyy}'}" Classes="Value"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Prix d'achat" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.PurchasePrice, StringFormat='{}{0:C2}'}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Prix de vente" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.SalePrice, StringFormat='{}{0:C2}'}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="1" Spacing="4">
                                    <TextBlock Text="Stock" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.StockQuantity}" Classes="Value"/>
                                </StackPanel>                                                 
                            </Grid>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Description" Classes="Label"/>
                                <TextBlock Text="{Binding Product.Description}" Foreground="#E0E0E0" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card" IsVisible="{Binding IsGlassCategory}">
                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,16,12">
                                    <TextBlock Text="Matière" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.GlassDetail.Material}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="0,0,16,12">
                                    <TextBlock Text="Type" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.GlassDetail.GlassType}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="0" Spacing="4" Margin="0,0,16,12">
                                    <TextBlock Text="Diamètre" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.GlassDetail.Diameter}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="Indice" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.GlassDetail.Index}" Classes="Value"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Puissance Min" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.GlassDetail.PowerLimitMin}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Puissance Max" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.GlassDetail.PowerLimitMax}" Classes="Value"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="Card" IsVisible="{Binding IsLensCategory}">
                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4" Margin="0,0,16,12">
                                    <TextBlock Text="Marque" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.LensDetail.Brand}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="0,0,16,12">
                                    <TextBlock Text="Modèle" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.LensDetail.Model}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="0" Spacing="4" Margin="0,0,16,12">
                                    <TextBlock Text="Matière" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.LensDetail.Material}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="Type" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.LensDetail.LensType}" Classes="Value"/>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Diamètre" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.LensDetail.Diameter}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Courbure" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.LensDetail.BaseCurve}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Colorée" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.LensDetail.IsColored}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Grid.Row="1" Spacing="4" Margin="0,0,0,0">
                                    <TextBlock Text="Durée" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.LensDetail.Duration}" Classes="Value"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="Card" IsVisible="{Binding IsAccessoryCategory}">
                            <Grid ColumnDefinitions="*,*,*">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Couleur" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.AccessoryDetail.Color}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Taille" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.AccessoryDetail.Size}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Matière" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.AccessoryDetail.Material}" Classes="Value"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Spécifications techniques" Classes="Label"/>
                                <TextBlock Text="{Binding Product.TechnicalSpecs}" Foreground="#E0E0E0" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="Card">
                            <Grid ColumnDefinitions="Auto,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Seuil d'alerte" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.StockAlertThreshold}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="Actif" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.IsActive}" Classes="Value"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="ID" Classes="Label"/>
                                    <TextBlock Text="{Binding Product.ProductId}" Classes="Value"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Historique">
                <views:ProductOrderHistoryView DataContext="{Binding}" />
            </TabItem>
        </TabControl>

        </Grid>
    </Border>
</UserControl>