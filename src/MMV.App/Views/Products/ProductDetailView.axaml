<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:converters="using:MMV.App.Converters"
             xmlns:views="using:MMV.App.Views.Products"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Products.ProductDetailView"
             x:DataType="vm:ProductDetailViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TabControl">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <ContentPresenter Name="PART_HeaderContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <Border Name="PART_Indicator"
                                Background="{DynamicResource AccentBrush}"
                                Height="2"
                                VerticalAlignment="Bottom"
                                IsVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_Indicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.Value">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style Selector="Border.DetailSection">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,24"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,24">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <controls:BackButton Grid.Column="0"
                                     Command="{Binding BackCommand}"
                                     ButtonText="Retour"
                                     VerticalAlignment="Top"
                                     Margin="0,4,32,0"/>

                <Grid Grid.Column="1" ColumnDefinitions="Auto, *">
                    <Border Grid.Column="0" VerticalAlignment="Top" Width="64" Height="64" CornerRadius="8" Background="{DynamicResource SurfaceLightBrush}" Margin="0,0,24,0">
                         <PathIcon Data="{StaticResource IconProducts}" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Product.Name}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Product.Category}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{Binding Product.Reference}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="•" Foreground="{DynamicResource BorderBrush}"/>
                            <TextBlock Text="{Binding Product.Supplier.Name}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="16">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Product.SalePrice, StringFormat='{}{0:C2}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="Prix TTC" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{Binding EditCommand}" Classes="Primary" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconSettings}" Width="14" />
                                <TextBlock Text="Modifier"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteCommand}" Background="{DynamicResource ErrorBrush}" Foreground="{DynamicResource ErrorBrush}" CornerRadius="{DynamicResource MediumCornerRadius}" BorderThickness="0" Cursor="Hand" Padding="16,8">
                            <PathIcon Data="{StaticResource IconTrash}" Width="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TabControl>
                <TabItem Header="Fiche Technique">
                    <ScrollViewer Padding="40">
                        <Grid ColumnDefinitions="2*, 40, 1*">
                            
                            <StackPanel Grid.Column="0">
                                
                                <Border Classes="DetailSection" BorderThickness="0,0,0,1" Padding="0,0,0,24" Margin="0,0,0,24">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="STOCK ET PRIX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <Grid ColumnDefinitions="*, *">
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Stock Actuel" Classes="Label"/>
                                                <TextBlock Text="{Binding Product.StockQuantity}" Classes="Value" FontSize="18"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock Text="Prix Achat HT" Classes="Label"/>
                                                <TextBlock Text="{Binding Product.PurchasePrice, StringFormat='{}{0:C2}'}" Classes="Value"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="CARACTÉRISTIQUES TECHNIQUES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>
                                    
                                    <Grid IsVisible="{Binding IsGlassCategory}" ColumnDefinitions="*,*" RowDefinitions="Auto, Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                            <TextBlock Text="Matière" Classes="Label"/>
                                            <TextBlock Text="{Binding GlassMaterial}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                            <TextBlock Text="Type" Classes="Label"/>
                                            <TextBlock Text="{Binding GlassType}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                            <TextBlock Text="Indice" Classes="Label"/>
                                            <TextBlock Text="{Binding GlassIndex}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                                            <TextBlock Text="Diamètre" Classes="Label"/>
                                            <TextBlock Text="{Binding GlassDiameter}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Puissance" Classes="Label"/>
                                            <TextBlock Classes="Value">
                                                <Run Text="{Binding GlassPowerLimitMin}"/>
                                                <Run Text=" à " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                                <Run Text="{Binding GlassPowerLimitMax}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Grid IsVisible="{Binding IsLensCategory}" ColumnDefinitions="*,*" RowDefinitions="Auto, Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                            <TextBlock Text="Marque / Modèle" Classes="Label"/>
                                            <TextBlock Classes="Value">
                                                <Run Text="{Binding LensBrand}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding LensModel}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                            <TextBlock Text="Type" Classes="Label"/>
                                            <TextBlock Text="{Binding LensType}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                            <TextBlock Text="Matériau" Classes="Label"/>
                                            <TextBlock Text="{Binding LensMaterial}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                                            <TextBlock Text="Durée" Classes="Label"/>
                                            <TextBlock Text="{Binding LensDuration}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Paramètres" Classes="Label"/>
                                            <TextBlock Classes="Value">
                                                <Run Text="BC: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                                <Run Text="{Binding LensBaseCurve}"/>
                                                <Run Text="  DIA: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                                <Run Text="{Binding LensDiameter}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Grid IsVisible="{Binding IsAccessoryCategory}" ColumnDefinitions="*,*" RowDefinitions="Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                            <TextBlock Text="Couleur" Classes="Label"/>
                                            <TextBlock Text="{Binding AccessoryColor}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                            <TextBlock Text="Matière" Classes="Label"/>
                                            <TextBlock Text="{Binding AccessoryMaterial}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Text="Taille" Classes="Label"/>
                                            <TextBlock Text="{Binding AccessorySize}" Classes="Value"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Stretch" Margin="19,0"/>

                            <StackPanel Grid.Column="2" Spacing="32">
                                <StackPanel>
                                    <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>
                                    <TextBlock Text="{Binding Product.Description}" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.8"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="ADMINISTRATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>
                                    <Grid ColumnDefinitions="Auto, *">
                                        <StackPanel>
                                            <TextBlock Text="Date entrée" Classes="Label"/>
                                            <TextBlock Text="{Binding Product.EntryDate, StringFormat='{}{0:dd/MM/yyyy}'}" Classes="Value"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                            <TextBlock Text="Seuil Alerte" Classes="Label"/>
                                            <TextBlock Text="{Binding Product.StockAlertThreshold}" Classes="Value" Foreground="{DynamicResource WarningBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Mouvements de Stock">
                    <views:ProductOrderHistoryView DataContext="{Binding}"/>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>