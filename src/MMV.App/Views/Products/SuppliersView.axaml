<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:converters="using:MMV.App.Converters"
             xmlns:views="using:MMV.App.Views.Products"
             x:Class="MMV.App.Views.Products.SuppliersView"
             x:DataType="vm:SuppliersViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="Border.SupplierRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="Border.SupplierRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
        </Style>

        <Style Selector="TextBlock.ColHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.FilterInput">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,15" IsVisible="{Binding ShowList}">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <controls:BackButton Command="{Binding BackToProductsCommand}"
                                         ButtonText="Retour"
                                         VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Fournisseurs" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SuppliersListViewModel.TotalSuppliers, StringFormat='{}{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding SuppliersListViewModel.IsLoading}" Width="80" Height="2" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBox Classes="FilterInput"
                                 Text="{Binding SuppliersListViewModel.SearchText, Mode=TwoWay}"
                                 Watermark="Rechercher..."
                                 Width="250"/>
                        <PathIcon Data="{StaticResource IconSearch}" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                    </Grid>


                    <Button Command="{Binding SuppliersListViewModel.CreateCommand}" Classes="Primary" Padding="16,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" Width="10" Height="10" Foreground="White"/>
                            <TextBlock Text="Nouveau" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto, *" IsVisible="{Binding ShowList}" MaxHeight="850">

            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid ColumnDefinitions="80, 2*, 2*, 2*, 2*, 100">
                    <TextBlock Grid.Column="0" Text="CODE" Classes="ColHeader"/>
                    <TextBlock Grid.Column="1" Text="ENTREPRISE" Classes="ColHeader"/>
                    <TextBlock Grid.Column="2" Text="CONTACT" Classes="ColHeader"/>
                    <TextBlock Grid.Column="3" Text="ADRESSE" Classes="ColHeader"/>
                    <TextBlock Grid.Column="4" Text="EMAIL" Classes="ColHeader"/>
                    <TextBlock Grid.Column="5" Text="CATALOGUE" Classes="ColHeader" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding SuppliersListViewModel.FilteredSuppliers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="SupplierRow" PointerPressed="Border_PointerPressed">
                                    <Grid ColumnDefinitions="80, 2*, 2*, 2*, 2*, 100">

                                        <TextBlock Grid.Column="0" Text="{Binding ReferenceCode}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Phone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <PathIcon Data="{StaticResource IconPhone}" Width="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" Opacity="0.8">
                                            <PathIcon Data="{StaticResource IconLocation}" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Address}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" Opacity="0.8" IsVisible="{Binding ContactEmail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <PathIcon Data="{StaticResource IconMail}" Width="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ContactEmail}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="12" Padding="12,4">
                                            <TextBlock FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}">
                                                <Run Text="{Binding Products.Count}"/>
                                                <Run Text=" ref." FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                        </Border>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel IsVisible="{Binding SuppliersListViewModel.FilteredSuppliers, Converter={x:Static ObjectConverters.IsNull}}"
                                HorizontalAlignment="Center" Margin="0,100" Spacing="15" Opacity="0.5">
                        <PathIcon Data="{StaticResource IconSearch}" Width="48" Height="48" Foreground="{DynamicResource TextDisabledBrush}"/>
                        <TextBlock Text="Aucun fournisseur trouvé" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,10" IsVisible="{Binding ShowList}">
            <Grid ColumnDefinitions="*, Auto">

                <TextBlock Grid.Column="0"
                           Text="{Binding SuppliersListViewModel.ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="NavButton" Command="{Binding SuppliersListViewModel.PreviousPageCommand}">
                        <PathIcon Data="{StaticResource IconBack}" Width="12"/>
                    </Button>

                    <TextBlock Text="{Binding SuppliersListViewModel.CurrentPage, StringFormat='Page {0}'}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"/>

                    <Button Classes="NavButton" Command="{Binding SuppliersListViewModel.NextPageCommand}">
                        <PathIcon Data="{StaticResource IconBack}" Width="12" RenderTransform="rotate(180deg)"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Panel Background="#80000000">
            <Panel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsInEditMode"/>
                    <Binding Path="IsCreatingNew"/>
                </MultiBinding>
            </Panel.IsVisible>
            <views:SupplierFormView DataContext="{Binding SupplierFormViewModel}"/>
        </Panel>

        <Panel IsVisible="{Binding IsShowingDetail}" Background="#80000000">
            <views:SupplierDetailView DataContext="{Binding SupplierDetailViewModel}"/>
        </Panel>

    </Grid>
</UserControl>