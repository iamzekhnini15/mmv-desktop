<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:views="using:MMV.App.Views.Products"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Products.SuppliersView"
             x:DataType="vm:SuppliersViewModel"
             Background="#1D1D1D">

    <UserControl.Styles>
        <Style Selector="Border.ToolbarCard">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Border.SupplierCard">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.SupplierCard:pointerover">
            <Setter Property="Background" Value="#2A2A2E"/>
            <Setter Property="BorderBrush" Value="#3A3A3E"/>
        </Style>

        <Style Selector="Button.PrimaryButton">
            <Setter Property="Background" Value="#0071E3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.PrimaryButton:pointerover">
            <Setter Property="Background" Value="#005BB5"/>
        </Style>

        <Style Selector="Button.PaginationButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.PaginationButton:pointerover">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- HEADER -->
        <Border Grid.Row="0" Padding="32,20,32,8" IsVisible="{Binding ShowList}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:BackButton Grid.Column="0"
                                     Command="{Binding BackToProductsCommand}"
                                     ButtonText="← Produits"
                                     Margin="0,0,24,0"/>

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Fournisseurs" FontSize="24" FontWeight="700" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding SuppliersListViewModel.TotalSuppliers, StringFormat='{}{0} fournisseur(s)'}"
                               FontSize="12" Foreground="#858585"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Nouveau fournisseur"
                        Classes="PrimaryButton"
                        Command="{Binding SuppliersListViewModel.CreateCommand}"/>
            </Grid>
        </Border>

        <!-- LISTE -->
        <ScrollViewer Grid.Row="1"
                      Padding="32,0,32,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding ShowList}">
            <StackPanel Spacing="0">
                <!-- Barre de Recherche -->
                <Border Classes="ToolbarCard">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SuppliersListViewModel.SearchText}"
                                 Watermark="Rechercher (nom, email, téléphone, référence...)"
                                 Padding="12,8"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SuppliersListViewModel.FilteredCount, StringFormat='{}{0}'}"
                                   FontSize="12"
                                   Foreground="#858585"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Liste des fournisseurs -->
                <ItemsControl ItemsSource="{Binding SuppliersListViewModel.FilteredSuppliers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="SupplierCard" PointerPressed="Border_PointerPressed">
                                <Grid ColumnDefinitions="*,*,*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="600" FontSize="14"/>
                                        <TextBlock Text="{Binding ReferenceCode}" Foreground="#A0A0A0" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ContactEmail}" Foreground="#A0A0A0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Phone}" Foreground="#888888" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Address}" Foreground="#A0A0A0" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="3" Background="#1F1F1F" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Products.Count, StringFormat='{}{0} produit(s)'}"
                                                   FontSize="10"
                                                   Foreground="#888"
                                                   FontWeight="600"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Message si vide -->
                <Border IsVisible="{Binding SuppliersListViewModel.FilteredSuppliers, Converter={x:Static ObjectConverters.IsNull}}"
                        Background="#252526"
                        CornerRadius="8"
                        Padding="40"
                        Margin="0,20,0,20">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="Aucun fournisseur trouvé" FontSize="15" Foreground="#A0A0A0" FontWeight="600"/>
                        <TextBlock Text="Essayez de modifier votre recherche" FontSize="12" Foreground="#666"/>
                    </StackPanel>
                </Border>

                <Border Height="10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER / PAGINATION -->
        <Border Grid.Row="2" Padding="32,12,32,12" BorderBrush="#333333" BorderThickness="0,1,0,0" IsVisible="{Binding ShowList}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding SuppliersListViewModel.IsLoading}"
                                 Width="80"
                                 Height="2"
                                 Foreground="#0071E3"/>
                    <TextBlock Text="{Binding SuppliersListViewModel.ErrorMessage}"
                               Foreground="#FF453A"
                               IsVisible="{Binding SuppliersListViewModel.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="500"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="← Précédent"
                            Command="{Binding SuppliersListViewModel.PreviousPageCommand}"
                            Classes="PaginationButton"
                            FontSize="12"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SuppliersListViewModel.CurrentPage}"
                                   VerticalAlignment="Center" FontWeight="600" Foreground="#FFFFFF" FontSize="12"/>
                        <TextBlock Text="/" VerticalAlignment="Center" Foreground="#666" FontSize="12" Margin="4,0"/>
                        <TextBlock Text="{Binding SuppliersListViewModel.TotalPages}"
                                   VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="12"/>
                    </StackPanel>

                    <Button Content="Suivant →"
                            Command="{Binding SuppliersListViewModel.NextPageCommand}"
                            Classes="PaginationButton"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORMULAIRE FOURNISSEUR -->
        <Panel IsVisible="{Binding IsInEditMode}">
            <views:SupplierFormView DataContext="{Binding SupplierFormViewModel}"/>
        </Panel>

        <!-- FICHE DÉTAILLÉE FOURNISSEUR -->
        <Panel IsVisible="{Binding IsShowingDetail}">
            <views:SupplierDetailView DataContext="{Binding SupplierDetailViewModel}"/>
        </Panel>
    </Grid>
</UserControl>
