<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:views="using:MMV.App.Views.Products"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Products.StockMovementsView"
             x:DataType="vm:StockMovementsViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="Border.MovementRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Border.MovementRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
        </Style>

        <Style Selector="TextBlock.ColHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.FilterInput">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="ComboBox.FilterInput">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16" IsVisible="{Binding ShowList}">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <controls:BackButton Command="{Binding BackToProductsCommand}" ButtonText="Retour" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}"/>
    
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Mouvements de Stock" FontSize="18" FontWeight="Bold"/>
                        <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="{Binding ListViewModel.TotalMovements, StringFormat='{}{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                
                <Button Grid.Column="2" 
                       Command="{Binding ListViewModel.CreateMovementCommand}"
                       Classes="Primary" Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPlus}" Width="10" Foreground="White"/>
                        <TextBlock Text="Nouveau Mouvement" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *" IsVisible="{Binding ShowList}" MaxHeight="850">
            
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBox Classes="FilterInput"
                                     Text="{Binding ListViewModel.SearchText, Mode=TwoWay}"
                                     Watermark="Rechercher..."
                                     Width="250"/>
                            <PathIcon Data="{StaticResource IconSearch}" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                        </Grid>
                    
                        <ComboBox Classes="FilterInput"
                                  ItemsSource="{Binding ListViewModel.MovementTypes}" 
                                  SelectedItem="{Binding ListViewModel.SelectedMovementType}" 
                                  PlaceholderText="Type"
                                  Width="150">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <ComboBox Classes="FilterInput"
                                  ItemsSource="{Binding ListViewModel.Products}" 
                                  SelectedValue="{Binding ListViewModel.SelectedProductId}" 
                                  PlaceholderText="Produit"
                                  Width="200">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding ListViewModel.ExportCommand}" Classes="Secondary" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconReports}" Width="12"/>
                            <TextBlock Text="Exporter" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid ColumnDefinitions="140, 2*, 2*, 120, 80">
                    <TextBlock Grid.Column="0" Text="DATE &amp; HEURE" Classes="ColHeader"/>
                    <TextBlock Grid.Column="1" Text="PRODUIT CONCERNÉ" Classes="ColHeader"/>
                    <TextBlock Grid.Column="2" Text="MOTIF / RAISON" Classes="ColHeader"/>
                    <TextBlock Grid.Column="3" Text="TYPE" Classes="ColHeader" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="QUANTITÉ" Classes="ColHeader" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2">
                <Grid RowDefinitions="Auto, *, Auto">
                    
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="20" IsVisible="{Binding ListViewModel.IsLoading}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <ProgressBar IsIndeterminate="True" Width="20" Height="20" Classes="Circular"/>
                            <TextBlock Text="Chargement..." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ListViewModel.Movements}" IsVisible="{Binding !ListViewModel.IsLoading}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="MovementRow">
                                    <Grid ColumnDefinitions="140, 2*, 2*, 120, 80">
                                        
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Product.Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Product.Reference}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Reason}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>

                                        <Border Grid.Column="3" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MovementType}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <TextBlock Grid.Column="4" Text="{Binding Quantity, StringFormat='{}{0:+0;-0}'}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontWeight="Bold" HorizontalAlignment="Right" FontSize="14"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <StackPanel Grid.Row="2" IsVisible="{Binding ListViewModel.Movements.Count, Converter={x:Static ObjectConverters.IsNull}}" 
                                HorizontalAlignment="Center" Margin="0,100" Spacing="15" Opacity="0.5">
                        <PathIcon Data="{StaticResource IconInventory}" Width="48" Height="48" Foreground="{DynamicResource TextDisabledBrush}"/>
                        <TextBlock Text="Aucun mouvement de stock" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" IsVisible="{Binding ShowList}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ListViewModel.ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" FontSize="12"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="NavButton" Command="{Binding ListViewModel.PreviousPageCommand}">
                        <PathIcon Data="{StaticResource IconBack}" Width="10"/>
                    </Button>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ListViewModel.CurrentPage}" VerticalAlignment="Center" FontWeight="600" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        <TextBlock Text="/" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="4,0"/>
                        <TextBlock Text="{Binding ListViewModel.TotalPages}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                    
                    <Button Classes="NavButton" Command="{Binding ListViewModel.NextPageCommand}">
                        <PathIcon Data="{StaticResource IconBack}" Width="10" RenderTransform="rotate(180deg)"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Panel Grid.Row="0" Grid.RowSpan="3" Background="#80000000" IsVisible="{Binding IsShowingForm}">
            <views:StockMovementFormView DataContext="{Binding FormViewModel}"/>
        </Panel>
    </Grid>
</UserControl>