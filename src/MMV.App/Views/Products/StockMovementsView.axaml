<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Products.StockMovementsView"
             x:DataType="vm:StockMovementsViewModel"
             Background="#1D1D1D">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Padding="32,24,32,16" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:BackButton Grid.Column="0"
                                     Command="{Binding BackToProductsCommand}"
                                     ButtonText="← Retour aux Produits"
                                     Margin="0,0,24,0"/>

                <TextBlock Grid.Column="1"
                           Text="📦 Mouvements de Stock"
                           FontSize="24"
                           FontWeight="700"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- Content -->
        <Panel Grid.Row="1">
            <!-- Liste des mouvements -->
            <ScrollViewer IsVisible="{Binding ShowList}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24">
                    <!-- Filters -->
                    <Border Background="#252526" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="*,16,*,16,*,16,Auto" RowDefinitions="Auto,8,Auto">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Recherche" Foreground="#CCCCCC" FontSize="13"/>
                                <TextBox Text="{Binding ListViewModel.SearchText}"
                                        Watermark="🔍 Rechercher..."
                                        Background="#3C3C3C"
                                        Foreground="#FFFFFF"
                                        BorderBrush="Transparent"
                                        CornerRadius="6"
                                        Padding="12,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="Type de mouvement" Foreground="#CCCCCC" FontSize="13"/>
                                <ComboBox ItemsSource="{Binding ListViewModel.MovementTypes}"
                                          SelectedItem="{Binding ListViewModel.SelectedMovementType}"
                                          PlaceholderText="Tous les types"
                                          Background="#3C3C3C"
                                          Foreground="#FFFFFF"
                                          BorderBrush="Transparent"
                                          CornerRadius="6"
                                          Padding="12,8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Spacing="6">
                                <TextBlock Text="Produit" Foreground="#CCCCCC" FontSize="13"/>
                                <ComboBox ItemsSource="{Binding ListViewModel.Products}"
                                          SelectedValue="{Binding ListViewModel.SelectedProductId}"
                                          PlaceholderText="Tous les produits"
                                          Background="#3C3C3C"
                                          Foreground="#FFFFFF"
                                          BorderBrush="Transparent"
                                          CornerRadius="6"
                                          Padding="12,8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="6"
                                    Content="➕ Nouveau Mouvement"
                                    Command="{Binding ListViewModel.CreateMovementCommand}"
                                    Background="#0071E3"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    Padding="16,10"
                                    FontWeight="600"
                                    Cursor="Hand"
                                    VerticalAlignment="Bottom"/>

                            <TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="7"
                                       Foreground="#888888"
                                       FontSize="12">
                                <Run Text="{Binding ListViewModel.TotalMovements}"/>
                                <Run Text=" mouvement(s)"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Loading -->
                    <Border Background="#252526" CornerRadius="8" Padding="48" IsVisible="{Binding ListViewModel.IsLoading}">
                        <controls:LoadingSpinner />
                    </Border>

                    <!-- Movements List -->
                    <Border Background="#252526" CornerRadius="8" IsVisible="{Binding !ListViewModel.IsLoading}">
                        <DataGrid ItemsSource="{Binding ListViewModel.Movements}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowBackground="#252526"
                                  ColumnHeaderHeight="40"
                                  RowHeight="48">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150"/>
                                <DataGridTextColumn Header="Produit" Binding="{Binding Product.Name}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="120"/>
                                <DataGridTextColumn Header="Quantité" Binding="{Binding Quantity}" Width="100"/>
                                <DataGridTextColumn Header="Raison" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Formulaire -->
            <ContentControl Content="{Binding FormViewModel}" IsVisible="{Binding IsShowingForm}"/>
        </Panel>
    </Grid>
</UserControl>
