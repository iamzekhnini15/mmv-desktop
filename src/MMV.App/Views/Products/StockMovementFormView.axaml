<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Products.StockMovementFormView"
             x:DataType="vm:StockMovementFormViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TextBox, ComboBox, NumericUpDown">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="Transparent"/> <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        
        <Style Selector="TextBox:focus, NumericUpDown:focus">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="TextBlock.ListHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
        </Style>

        <Style Selector="Border.InputRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.InputRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *, Auto" MaxHeight="850">
        
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:BackButton Grid.Column="0" Command="{Binding CancelCommand}" ButtonText="Annuler" Margin="0,0,32,0"/>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Saisie de Mouvements" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Ajoutez les lignes correspondant aux entrées/sorties physiques." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button Content="Valider les mouvements" 
                            Command="{Binding SaveCommand}" 
                            IsEnabled="{Binding !IsSaving}"
                            Classes="Primary" 
                            Padding="24,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="3*, 1.5*, 1*, 2*, 50">
                <TextBlock Grid.Column="0" Text="PRODUIT (RECHERCHE)" Classes="ListHeader"/>
                <TextBlock Grid.Column="1" Text="TYPE DE MOUVEMENT" Classes="ListHeader"/>
                <TextBlock Grid.Column="2" Text="QUANTITÉ" Classes="ListHeader"/>
                <TextBlock Grid.Column="3" Text="NOTES / MOTIF" Classes="ListHeader"/>
                <TextBlock Grid.Column="4" Text="" Classes="ListHeader"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding MovementLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="InputRow">
                                <Grid ColumnDefinitions="3*, 1.5*, 1*, 2*, 50">
                                    
                                    <Grid Grid.Column="0" Margin="4">
                                        <TextBox Name="SearchBox" 
                                                 Text="{Binding SearchText, Mode=TwoWay}" 
                                                 Watermark="Référence, Nom..."
                                                 Classes="SearchInput">
                                            <TextBox.InnerLeftContent>
                                                <PathIcon Data="{StaticResource IconSearch}" Width="12" Margin="8,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </TextBox.InnerLeftContent>
                                        </TextBox>
                                        
                                        <Popup IsOpen="{Binding IsPopupOpen, Mode=TwoWay}" 
                                               PlacementTarget="{Binding ElementName=SearchBox}"
                                               Placement="Bottom">
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="0" MaxHeight="300" Width="500">
                                                <ListBox ItemsSource="{Binding FilteredProducts}" 
                                                         SelectedItem="{Binding Product, Mode=TwoWay}"
                                                         Background="Transparent">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="100, *">
                                                                <TextBlock Text="{Binding Reference}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,0,0" FontSize="13"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                                        <ComboBox ItemsSource="{Binding $parent[ItemsControl].((vm:StockMovementFormViewModel)DataContext).MovementTypes}" 
                                                  SelectedItem="{Binding MovementType}" 
                                                  HorizontalAlignment="Stretch"
                                                  BorderThickness="0"/>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                                        <NumericUpDown Value="{Binding Quantity}" 
                                                       Minimum="1" Maximum="99999" Increment="1" 
                                                       FormatString="0"
                                                       HorizontalAlignment="Stretch"
                                                       BorderThickness="0"/>
                                    </Border>

                                    <Border Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                                        <TextBox Text="{Binding Notes}" 
                                                 Watermark="Optionnel (ex: Commande #123)"
                                                 BorderThickness="0"/>
                                    </Border>

                                    <Button Grid.Column="4" 
                                            Command="{Binding $parent[ItemsControl].((vm:StockMovementFormViewModel)DataContext).RemoveLineCommand}" 
                                            CommandParameter="{Binding}"
                                            Background="Transparent" 
                                            Foreground="{DynamicResource TextDisabledBrush}"
                                            BorderThickness="0"
                                            HorizontalAlignment="Center"
                                            Cursor="Hand">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover PathIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                        <PathIcon Data="{StaticResource IconTrash}" Width="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Command="{Binding AddLineCommand}" 
                        Background="Transparent" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="24,16"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconPlus}" Width="14" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Ajouter une ligne" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Button>
                
                <Border Height="100"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20" IsVisible="{Binding !!ErrorMessage}">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconReports}" Width="16" Foreground="{DynamicResource ErrorBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#99000000" IsVisible="{Binding IsSaving}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <ProgressBar IsIndeterminate="True" Classes="Circular" Width="60" Height="60"/>
                <TextBlock Text="Enregistrement des mouvements..." Foreground="White" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>