<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="MMV.App.Views.Products.ProductFormView"
             x:DataType="vm:ProductFormViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <Button Grid.Column="0" Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconBack}" Width="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Retour" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button Content="Annuler" Command="{Binding CancelCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0"/>
                    <Button Content="Enregistrer le produit" Command="{Binding SaveCommand}" Classes="Primary"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <ScrollViewer Grid.Row="1">
            <Grid ColumnDefinitions="1.2*, 1, 1*" Margin="40">
                
                <StackPanel Grid.Column="0" Spacing="40" Margin="0,0,40,0">
                    
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconProducts}" Width="16" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="IDENTIFICATION DU PRODUIT" Classes="SectionTitle" Margin="0"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="1*, 2*">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                                    <TextBlock Text="Référence *" Classes="label"/>
                                    <TextBox Text="{Binding Reference}" Watermark="Ex: MON-001" Classes="Input"/>
                                    <TextBlock Text="{Binding ReferenceError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" IsVisible="{Binding ReferenceError, Converter={StaticResource StringToBoolConverter}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Désignation *" Classes="label"/>
                                    <TextBox Text="{Binding Name}" Watermark="Nom du produit" Classes="Input"/>
                                    <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" IsVisible="{Binding NameError, Converter={StaticResource StringToBoolConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Description détaillée" Classes="label"/>
                                <TextBox Text="{Binding Description}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Classes="Input"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                                    <TextBlock Text="Catégorie *" Classes="label"/>
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" PlaceholderText="Sélectionner..." HorizontalAlignment="Stretch" Classes="Input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Fournisseur *" Classes="label"/>
                                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" PlaceholderText="Sélectionner..." HorizontalAlignment="Stretch" Classes="Input">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconSales}" Width="16" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="TARIFICATION &amp; MARGES" Classes="SectionTitle" Margin="0"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *, *">
                            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                                <TextBlock Text="Prix Achat HT *" Classes="label"/>
                                <TextBox Text="{Binding PurchasePrice}" Watermark="0.00" Classes="Input"/>
                                <TextBlock Text="{Binding PurchasePriceError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" IsVisible="{Binding PurchasePriceError, Converter={StaticResource StringToBoolConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,12,0">
                                <TextBlock Text="Prix Vente TTC *" Classes="label"/>
                                <TextBox Text="{Binding SalePrice}" Watermark="0.00" Classes="Input" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SalePriceError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" IsVisible="{Binding SalePriceError, Converter={StaticResource StringToBoolConverter}}"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource SurfaceLightBrush}" CornerRadius="6" Padding="12" VerticalAlignment="Top" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="MARGE COMMERCIALE" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Margin, StringFormat='{}{0:C2}'}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding MarginPercentage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" Spacing="40" Margin="40,0,0,0">
                    
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconInventory}" Width="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="GESTION DU STOCK" Classes="SectionTitle" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                                <TextBlock Text="Quantité actuelle *" Classes="label"/>
                                <TextBox Text="{Binding StockQuantity}" Watermark="0" Classes="Input"/>
                                <TextBlock Text="{Binding StockQuantityError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" IsVisible="{Binding StockQuantityError, Converter={StaticResource StringToBoolConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Seuil d'alerte *" Classes="label"/>
                                <TextBox Text="{Binding StockAlertThreshold}" Watermark="5" Classes="Input"/>
                                <TextBlock Text="{Binding StockAlertThresholdError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" IsVisible="{Binding StockAlertThresholdError, Converter={StaticResource StringToBoolConverter}}"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Text="Une notification sera envoyée si le stock passe sous le seuil." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                    <StackPanel IsVisible="{Binding IsGlassCategory}">
                        <TextBlock Text="SPÉCIFICITÉS VERRES" Classes="SectionTitle" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Matière" Classes="label"/>
                                    <ComboBox SelectedItem="{Binding GlassMaterial}" HorizontalAlignment="Stretch" Classes="Input">
                                        <ComboBox.Items><x:String>MINERAL</x:String><x:String>ORGANIQUE</x:String><x:String>POLYCARBONATE</x:String><x:String>TRIVEX</x:String></ComboBox.Items>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Type" Classes="label"/>
                                    <ComboBox SelectedItem="{Binding GlassType}" HorizontalAlignment="Stretch" Classes="Input">
                                        <ComboBox.Items><x:String>SF</x:String><x:String>DF</x:String><x:String>MF</x:String></ComboBox.Items>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="Diamètre" Classes="label"/>
                                    <TextBox Text="{Binding GlassDiameter}" Classes="Input"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Indice" Classes="label"/>
                                    <TextBox Text="{Binding GlassIndex}" Classes="Input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="P. Min" Classes="label"/>
                                    <TextBox Text="{Binding PowerLimitMin}" Classes="Input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="P. Max" Classes="label"/>
                                    <TextBox Text="{Binding PowerLimitMax}" Classes="Input"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsLensCategory}">
                        <TextBlock Text="SPÉCIFICITÉS LENTILLES" Classes="SectionTitle" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Marque" Classes="label"/>
                                    <TextBox Text="{Binding LensBrand}" Classes="Input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Modèle" Classes="label"/>
                                    <TextBox Text="{Binding LensModel}" Classes="Input"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Type" Classes="label"/>
                                    <ComboBox SelectedItem="{Binding LensType}" HorizontalAlignment="Stretch" Classes="Input">
                                        <ComboBox.Items><x:String>UNIFOCAL</x:String><x:String>MULTIFOCAL</x:String><x:String>TORIQUE</x:String></ComboBox.Items>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Diamètre" Classes="label"/>
                                    <TextBox Text="{Binding LensDiameter}" Classes="Input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="Courbure" Classes="label"/>
                                    <TextBox Text="{Binding LensBaseCurve}" Classes="Input"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Durée" Classes="label"/>
                                    <ComboBox SelectedItem="{Binding LensDuration}" HorizontalAlignment="Stretch" Classes="Input">
                                        <ComboBox.Items><x:String>JOURNALIERE</x:String><x:String>MENSUELLE</x:String><x:String>TRIMESTRIELLE</x:String><x:String>ANNUELLE</x:String></ComboBox.Items>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <CheckBox Content="Lentille colorée" IsChecked="{Binding LensIsColored}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAccessoryCategory}">
                        <TextBlock Text="DÉTAILS TECHNIQUES" Classes="SectionTitle" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Couleur" Classes="label"/>
                                    <TextBox Text="{Binding AccessoryColor}" Classes="Input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Taille / Calibre" Classes="label"/>
                                    <TextBox Text="{Binding AccessorySize}" Classes="Input"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Matière" Classes="label"/>
                                <TextBox Text="{Binding AccessoryMaterial}" Classes="Input"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding IsLoading}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="50" Height="50" Classes="Circular"/>
                <TextBlock Text="Enregistrement..." Foreground="White"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>