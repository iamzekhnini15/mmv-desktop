<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:MMV.App.Controls"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Products.SupplierFormView"
             x:DataType="vm:SupplierFormViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid ColumnDefinitions="Auto, *,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <controls:BackButton Command="{Binding CancelCommand}"
                                         ButtonText="Retour à la liste"
                                         Margin="0,0,0,0"/>

                    <Rectangle Width="1" Height="24" Fill="{DynamicResource BorderBrush}"/>

                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="Annuler" Padding="20,12" Cursor="Hand" CornerRadius="10" Command="{Binding CancelCommand}" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0"/>
                    <Button Content="Enregistrer le produit" Command="{Binding SaveCommand}" Classes="Primary"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <ScrollViewer Grid.Row="1">
            <Grid ColumnDefinitions="1*, 1, 1*" Margin="40">
                
                <StackPanel Grid.Column="0" Spacing="40" Margin="0,0,40,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconInventory}" Width="16" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="IDENTITÉ FOURNISSEUR" Classes="SectionTitle" Margin="0"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Raison Sociale / Nom *" Classes="label"/>
                                <TextBox Text="{Binding Name}" Watermark="Nom de l'entreprise" Classes="Input" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Code Référence" Classes="label"/>
                                <TextBox Text="{Binding ReferenceCode}" Watermark="Ex: SUP-001" Classes="Input"/>
                                <TextBlock Text="Code unique pour la gestion des stocks." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" Spacing="40" Margin="40,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                            <PathIcon Data="{StaticResource IconPhone}" Width="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="COORDONNÉES" Classes="SectionTitle" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0"/>
                        </StackPanel>

                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                                    <TextBlock Text="Email Contact" Classes="label"/>
                                    <TextBox Text="{Binding ContactEmail}" Watermark="email@fournisseur.com" Classes="Input"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Téléphone" Classes="label"/>
                                    <TextBox Text="{Binding Phone}" Watermark="+33..." Classes="Input"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Adresse Postale" Classes="label"/>
                                <TextBox Text="{Binding Address}" 
                                         Watermark="Adresse complète..." 
                                         Classes="Input" 
                                         Height="100" 
                                         AcceptsReturn="True" 
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#80000000" IsVisible="{Binding IsSaving}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="50" Height="50" Foreground="White"/>
                <TextBlock Text="Enregistrement..." Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>