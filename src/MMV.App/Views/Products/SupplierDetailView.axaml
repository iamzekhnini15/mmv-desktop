<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.Products.SupplierDetailView"
             x:DataType="vm:SupplierDetailViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="Border.ProductRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="TextBlock.ListLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,24">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <controls:BackButton Grid.Column="0"
                                     Command="{Binding BackCommand}"
                                     ButtonText="Retour"
                                     VerticalAlignment="Top"
                                     Margin="0,0,26,0"/>

                <Grid Grid.Column="1">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Supplier.Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{DynamicResource AccentFadeBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding Supplier.ReferenceCode}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding Products.Count, StringFormat='{}{0} produits référencés'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Command="{Binding EditCommand}" Classes="Primary" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconSettings}" Width="12"/>
                            <TextBlock Text="Modifier"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}" Background="{DynamicResource ErrorBrush}" Foreground="{DynamicResource ErrorBrush}" CornerRadius="{DynamicResource MediumCornerRadius}" BorderThickness="0" Cursor="Hand" Padding="16,8">
                            <PathIcon Data="{StaticResource IconTrash}" Width="14"/>
                        </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1*, 40, 2*" Margin="40">

            <StackPanel Grid.Column="0" Spacing="32">
                <StackPanel Spacing="16">
                    <TextBlock Text="COORDONNÉES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>

                    <StackPanel Spacing="16">
                        <StackPanel>
                            <TextBlock Text="Email" Classes="Label"/>
                            <SelectableTextBlock Text="{Binding Supplier.ContactEmail}" Classes="Value" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Téléphone" Classes="Label"/>
                            <SelectableTextBlock Text="{Binding Supplier.Phone}" Classes="Value"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8"/>

                        <StackPanel>
                            <TextBlock Text="Adresse" Classes="Label"/>
                            <TextBlock Text="{Binding Supplier.Address}" Classes="Value" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="CATALOGUE PRODUITS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16"/>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid RowDefinitions="Auto, *">
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceLightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Grid ColumnDefinitions="*, 150, 100">
                                <TextBlock Grid.Column="0" Text="DÉSIGNATION" Classes="ListLabel"/>
                                <TextBlock Grid.Column="1" Text="CATÉGORIE" Classes="ListLabel"/>
                                <TextBlock Grid.Column="2" Text="PRIX VENTE" Classes="ListLabel" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Products}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="ProductRow">
                                                <Grid ColumnDefinitions="*, 150, 100">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Reference}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2" Text="{Binding SalePrice, StringFormat='{}{0:C2}'}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel IsVisible="{Binding !HasProducts}" Spacing="12" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconProducts}" Width="32" Height="32" Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="Aucun produit associé." Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>