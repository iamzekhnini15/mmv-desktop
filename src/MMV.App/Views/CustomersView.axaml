<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:controls="using:MMV.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MMV.App.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">
    
    <!-- Grid principal - DataContext reste sur CustomersViewModel pour accéder à CustomersListViewModel -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Header avec titre -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="24,18" BorderBrush="#424245" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="👥  Gestion des Clients" FontSize="20" FontWeight="700" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding CustomersListViewModel.TotalCustomers, StringFormat='{}{0} clients au total'}" 
                              FontSize="13" Foreground="#A1A1A6"/>
                </StackPanel>
                
                <!-- Boutons d'action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button Content="➕  Nouveau"
                           Classes="PrimaryButton"
                           Click="ButtonNouveau_Click"/>
                    <Button Content="✏️  Modifier"
                           Background="#2D2D2D"
                           Foreground="#FFFFFF"
                           Command="{Binding CustomersListViewModel.EditCommand}"
                           Padding="16,10"
                           BorderThickness="1"
                           BorderBrush="#424245"
                           CornerRadius="8"
                           FontSize="13"
                           FontWeight="500"
                           Cursor="Hand"/>
                    <Button Content="🗑️  Supprimer"
                           Background="#3A1010"
                           Foreground="#FF3B30"
                           Command="{Binding CustomersListViewModel.DeleteCommand}"
                           Padding="16,10"
                           BorderThickness="1"
                           BorderBrush="#652020"
                           CornerRadius="8"
                           FontSize="13"
                           FontWeight="500"
                           Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Barre de recherche -->
        <Border Grid.Row="1" Background="#2D2D2D" Padding="24,16" BorderBrush="#424245" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding CustomersListViewModel.SearchText}"
                        Watermark="🔍  Rechercher par nom, email, téléphone..."
                        FontSize="13"
                        Padding="14,11"
                        Foreground="#FFFFFF"
                        Background="#2D2D2D"
                        BorderBrush="#424245"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,16,0"/>
                
                <!-- Compteur -->
                <TextBlock Grid.Column="1"
                          Text="{Binding CustomersListViewModel.FilteredCustomers.Count, StringFormat='{}{0} résultats'}"
                          FontSize="13"
                          Foreground="#A1A1A6"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
                
        <!-- DataGrid des clients -->
        <Border Grid.Row="2" Background="#1D1D1D" Padding="20" BorderBrush="#424245" BorderThickness="0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CustomersListViewModel.FilteredCustomers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2D2D2D" 
                                    Padding="16,12" 
                                    Margin="0,0,0,2" 
                                    Cursor="Hand"
                                    PointerPressed="Border_PointerPressed">
                                <Grid ColumnDefinitions="1.5*,1.5*,2*,1.5*,1.5*">
                                    <TextBlock Grid.Column="0" Text="{Binding FirstName}" Foreground="#FFFFFF" FontWeight="600" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastName}" Foreground="#FFFFFF" FontWeight="600" FontSize="14"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Email}" Foreground="#A1A1A6" FontSize="13"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Phone}" Foreground="#A1A1A6" FontSize="13"/>
                                    <TextBlock Grid.Column="4" Text="{Binding City}" Foreground="#A1A1A6" FontSize="13"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        
        <!-- Pagination et infos -->
        <Border Grid.Row="3" Background="#2D2D2D" Padding="24,14" BorderBrush="#424245" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0">
                <!-- Indicateurs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                IsVisible="{Binding CustomersListViewModel.IsLoading}"
                                Width="120"
                                Height="2"
                                Foreground="#0A84FF"/>
                    <TextBlock Text="{Binding CustomersListViewModel.ErrorMessage}"
                              Foreground="#FF3B30"
                              IsVisible="{Binding CustomersListViewModel.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              VerticalAlignment="Center"
                              FontSize="12"
                              FontWeight="500"/>
                </StackPanel>
                
                <!-- Pagination -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="◀  Précédent"
                           Command="{Binding CustomersListViewModel.PreviousPageCommand}"
                           Padding="14,9"
                           Background="#2D2D2D"
                           Foreground="#FFFFFF"
                           BorderThickness="1"
                           BorderBrush="#424245"
                           CornerRadius="8"
                           FontSize="12"
                           FontWeight="500"
                           Cursor="Hand"/>
                    <TextBlock Text="{Binding CustomersListViewModel.CurrentPage, StringFormat='Page {0}'}"
                              VerticalAlignment="Center"
                              FontWeight="600"
                              Foreground="#FFFFFF"
                              FontSize="12"/>
                    <TextBlock Text="{Binding CustomersListViewModel.TotalPages, StringFormat='/ {0}'}"
                              VerticalAlignment="Center"
                              Foreground="#A1A1A6"
                              FontSize="12"/>
                    <Button Content="Suivant  ▶"
                           Command="{Binding CustomersListViewModel.NextPageCommand}"
                           Padding="14,9"
                           Background="#2D2D2D"
                           Foreground="#FFFFFF"
                           BorderThickness="1"
                           BorderBrush="#424245"
                           CornerRadius="8"
                           FontSize="12"
                           FontWeight="500"
                           Cursor="Hand"/>
                </StackPanel>
                
                <!-- Bouton détails -->
                <Button Grid.Column="2"
                       Content="👁️  Voir détails"
                       Command="{Binding CustomersListViewModel.ViewDetailsCommand}"
                       Background="#0A84FF"
                       Foreground="White"
                       BorderThickness="0"
                       Padding="16,10"
                       CornerRadius="8"
                       FontSize="12"
                       FontWeight="500"
                       Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
