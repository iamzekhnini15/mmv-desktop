<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="using:MMV.App.ViewModels"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
            x:Class="MMV.App.Views.DashboardView"
            x:DataType="local:DashboardViewModel">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Titre -->
        <TextBlock Text="Tableau de Bord" FontSize="28" FontWeight="Bold" Foreground="#2D3E50" Margin="20,20,0,20"/>

        <!-- Contenu du tableau de bord -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" Margin="20">
                <!-- Cartes de statistiques -->
                <Grid ColumnDefinitions="1*,1*,1*,1*" RowDefinitions="Auto">
                    <!-- Carte Clients -->
                    <Border Grid.Column="0" Background="#3498DB" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="👥 Clients" FontSize="14" Foreground="White" Opacity="0.8"/>
                            <TextBlock Text="{Binding TotalCustomers}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- Carte Produits -->
                    <Border Grid.Column="1" Background="#2ECC71" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="📦 Produits" FontSize="14" Foreground="White" Opacity="0.8"/>
                            <TextBlock Text="{Binding TotalProducts}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- Carte Ventes -->
                    <Border Grid.Column="2" Background="#F39C12" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="💰 Ventes" FontSize="14" Foreground="White" Opacity="0.8"/>
                            <TextBlock Text="{Binding TotalSales}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- Carte Commandes en attente -->
                    <Border Grid.Column="3" Background="#E74C3C" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="🏭 En attente" FontSize="14" Foreground="White" Opacity="0.8"/>
                            <TextBlock Text="{Binding PendingOrders}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bienvenue -->
                <Border Background="#ECF0F1" CornerRadius="8" Padding="20">
                    <TextBlock Text="Bienvenue dans ManageMyVision! Utilisez le menu latéral pour accéder aux différents modules de gestion." 
                              TextWrapping="Wrap" Foreground="#34495E"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
