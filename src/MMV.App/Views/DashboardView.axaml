<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="using:MMV.App.ViewModels"
            mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
            x:Class="MMV.App.Views.DashboardView"
            x:DataType="local:DashboardViewModel"
            Background="#1D1D1D">
    
    <ScrollViewer>
        <Border Padding="0">
            <StackPanel Spacing="28" Margin="0">
                <!-- Titre de la page -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Tableau de Bord" FontSize="28" FontWeight="700" Foreground="#FFFFFF"/>
                    <TextBlock Text="Aperçu des performances et statistiques clés" FontSize="14" Foreground="#A1A1A6"/>
                </StackPanel>

                <!-- Grille de statistiques - Cartes colorées Apple Style -->
                <Grid ColumnDefinitions="1*,1*,1*,1*" RowDefinitions="Auto">
                    <Grid.Styles>
                        <Style Selector="Border">
                            <Setter Property="Margin" Value="0,0,16,0"/>
                        </Style>
                    </Grid.Styles>
                
                    <!-- Carte Clients - Bleu Apple -->
                    <Border Grid.Column="0" Background="#0A84FF" CornerRadius="12" Padding="24">
                        <StackPanel Spacing="14">
                            <TextBlock Text="👥  Clients" FontSize="14" Foreground="White" Opacity="0.95" FontWeight="600"/>
                            <TextBlock Text="{Binding TotalCustomers}" FontSize="40" FontWeight="700" Foreground="White"/>
                            <TextBlock Text="Total des clients" FontSize="12" Foreground="White" Opacity="0.85"/>
                        </StackPanel>
                    </Border>

                    <!-- Carte Produits - Vert Apple -->
                    <Border Grid.Column="1" Background="#30B0C0" CornerRadius="12" Padding="24">
                        <StackPanel Spacing="14">
                            <TextBlock Text="📦  Produits" FontSize="14" Foreground="White" Opacity="0.95" FontWeight="600"/>
                            <TextBlock Text="{Binding TotalProducts}" FontSize="40" FontWeight="700" Foreground="White"/>
                            <TextBlock Text="Articles en stock" FontSize="12" Foreground="White" Opacity="0.85"/>
                        </StackPanel>
                    </Border>

                    <!-- Carte Ventes - Orange Apple -->
                    <Border Grid.Column="2" Background="#FF9500" CornerRadius="12" Padding="24">
                        <StackPanel Spacing="14">
                            <TextBlock Text="💰  Chiffre d'affaires" FontSize="14" Foreground="White" Opacity="0.95" FontWeight="600"/>
                            <TextBlock Text="{Binding TotalSales}" FontSize="40" FontWeight="700" Foreground="White"/>
                            <TextBlock Text="Ventes totales" FontSize="12" Foreground="White" Opacity="0.85"/>
                        </StackPanel>
                    </Border>

                    <!-- Carte Commandes en attente - Rouge Apple -->
                    <Border Grid.Column="3" Background="#FF3B30" CornerRadius="12" Padding="24">
                        <StackPanel Spacing="14">
                            <TextBlock Text="🔔  En attente" FontSize="14" Foreground="White" Opacity="0.95" FontWeight="600"/>
                            <TextBlock Text="{Binding PendingOrders}" FontSize="40" FontWeight="700" Foreground="White"/>
                            <TextBlock Text="Commandes en cours" FontSize="12" Foreground="White" Opacity="0.85"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section info - Dark Card -->
                <Border Background="#2D2D2D" CornerRadius="12" Padding="24" BorderBrush="#424245" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Bienvenue dans ManageMyVision" FontSize="18" FontWeight="700" Foreground="#FFFFFF"/>
                        <TextBlock Text="Votre solution complète de gestion pour opticiens. Utilisez le menu pour accéder aux différents modules de gestion de votre activité." 
                                  FontSize="14"
                                  TextWrapping="Wrap"
                                  Foreground="#A1A1A6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>

</UserControl>
