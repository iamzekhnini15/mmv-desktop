<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             xmlns:conv="using:MMV.App.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MMV.App.Views.ChatDataView"
             x:DataType="vm:ChatDataViewModel"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToAlignmentConverter x:Key="BoolToAlign"/>
        <conv:BoolToColumnConverter x:Key="BoolToCol"/>
        <conv:BoolToCornerConverter x:Key="BoolToCorner"/>
        <conv:BoolToBackgroundConverter x:Key="BoolToBg"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <Border Grid.Row="0" Padding="24" Background="Transparent">
            <StackPanel Spacing="4">
                <TextBlock Text="Assistant IA" FontSize="26" FontWeight="Heavy" LetterSpacing="-0.5"/>
                <TextBlock Text="Analysez votre activité en langage naturel" FontSize="14" Opacity="0.6"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,0">
            <ItemsControl ItemsSource="{Binding ChatHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MaxWidth="700"/> <ColumnDefinition Width="*"/>                   <ColumnDefinition Width="Auto" MaxWidth="700"/> </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="{Binding IsUser, Converter={StaticResource BoolToCol}}"
                                        HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlign}}">

                                <Border Background="{Binding IsUser, Converter={StaticResource BoolToBg}}"
                                        CornerRadius="{Binding IsUser, Converter={StaticResource BoolToCorner}}"
                                        Padding="16,12"
                                        BoxShadow="0 2 5 0 #15000000">
                                    <StackPanel Spacing="6">
                                        
                                        <!-- Indicateur de typing (3 points animés) -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTyping}">
                                            <Ellipse Width="8" Height="8" Fill="White" Opacity="0.6">
                                                <Ellipse.Styles>
                                                    <Style Selector="Ellipse">
                                                        <Style.Animations>
                                                            <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                                <KeyFrame Cue="33%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                                <KeyFrame Cue="66%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                            </Animation>
                                                        </Style.Animations>
                                                    </Style>
                                                </Ellipse.Styles>
                                            </Ellipse>
                                            <Ellipse Width="8" Height="8" Fill="White" Opacity="0.6">
                                                <Ellipse.Styles>
                                                    <Style Selector="Ellipse">
                                                        <Style.Animations>
                                                            <Animation Duration="0:0:1.5" IterationCount="INFINITE" Delay="0:0:0.2">
                                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                                <KeyFrame Cue="33%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                                <KeyFrame Cue="66%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                            </Animation>
                                                        </Style.Animations>
                                                    </Style>
                                                </Ellipse.Styles>
                                            </Ellipse>
                                            <Ellipse Width="8" Height="8" Fill="White" Opacity="0.6">
                                                <Ellipse.Styles>
                                                    <Style Selector="Ellipse">
                                                        <Style.Animations>
                                                            <Animation Duration="0:0:1.5" IterationCount="INFINITE" Delay="0:0:0.4">
                                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                                <KeyFrame Cue="33%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                                <KeyFrame Cue="66%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                            </Animation>
                                                        </Style.Animations>
                                                    </Style>
                                                </Ellipse.Styles>
                                            </Ellipse>
                                        </StackPanel>

                                        <!-- Contenu du message -->
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   LineHeight="22"
                                                   IsVisible="{Binding !IsTyping}"/>

                                        <TextBlock Text="{Binding SqlQuery}"
                                                   IsVisible="{Binding !IsUser}"
                                                   FontFamily="Consolas" FontSize="10" Opacity="0.4" Foreground="White"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border IsVisible="{Binding HasData}"
                                        Margin="0,12,0,0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        BoxShadow="0 4 12 0 #1A000000">

                                    <StackPanel>
                                        <Border Padding="16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="📊 Données extraites" FontWeight="SemiBold" FontSize="13"/>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer MaxHeight="300" Padding="0">
                                            <ItemsControl ItemsSource="{Binding Data}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">

                                                            <ItemsControl ItemsSource="{Binding}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:CompileBindings="False">
                                                                        <Grid ColumnDefinitions="140, *" Margin="0,2">
                                                                            <TextBlock Text="{Binding Key}"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                       FontSize="13"/>
                                                                            <TextBlock Text="{Binding Value}"
                                                                                       Grid.Column="1"
                                                                                       FontWeight="Medium"
                                                                                       TextWrapping="Wrap"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                           FontSize="11"
                                           Opacity="0.5"
                                           Margin="4,6"
                                           HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlign}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24" Background="{DynamicResource BackgroundBrush}">
            <Grid ColumnDefinitions="*, 16, Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding UserInput}"
                         Watermark="Posez une question... (ex: Quel est le CA de janvier ?)"
                         Height="50"
                         CornerRadius="25"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="20,0"
                         FontSize="15">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Column="2"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Width="50" Height="50"
                        CornerRadius="25"
                        Background="{DynamicResource AccentBrush}"
                        HotKey="Enter">
                    <PathIcon Data="{StaticResource IconSend}" Foreground="White" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-40,0,0"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="16,8"
                BoxShadow="0 4 12 0 #20000000" IsVisible="{Binding IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="16" Height="16" Theme="{StaticResource FluentProgressBar}"/>
                <TextBlock Text="Analyse en cours..." FontSize="13" FontWeight="Medium"/>
                <Button Command="{Binding CancelCommand}" Content="✕"
                        Background="Transparent" Padding="4" Margin="4,0,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>