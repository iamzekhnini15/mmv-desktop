<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MMV.App.ViewModels"
        xmlns:converters="using:MMV.App.Converters"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="MMV.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ManageMyVision"
        
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="{DynamicResource BackgroundBrush}">

    <Grid ColumnDefinitions="260, *" Background="{DynamicResource BackgroundBrush}">
        
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto">
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="24,40,24,30">
                    <PathIcon Data="{StaticResource IconGlasses}" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="ManageMyVision" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" LetterSpacing="-0.5"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="12,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="MENU" Classes="label" Margin="12,10,0,8" Opacity="0.6"/>

                        <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="{StaticResource IconDashboard}" Width="18" />
                                <TextBlock Text="Tableau de Bord"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Customers">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="{StaticResource IconCustomers}" Width="18"/>
                                <TextBlock Text="Clients"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Products">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="{StaticResource IconProducts}" Width="18"/>
                                <TextBlock Text="Produits"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Prescriptions">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="{StaticResource IconPrescriptions}" Width="18"/>
                                <TextBlock Text="Ordonnances"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Sales"
                                IsVisible="{Binding CanSeeSalesModule}">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="{StaticResource IconSales}" Width="18"/>
                                <TextBlock Text="Ventes"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="8,15" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>
                        
                        <TextBlock Text="GESTION" Classes="label" Margin="12,0,0,8" Opacity="0.6"/>

                        <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Inventory">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="{StaticResource IconInventory}" Width="18"/>
                                <TextBlock Text="Inventaire"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Orders">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="{StaticResource IconOrders}" Width="18"/>
                                <TextBlock Text="Commandes Frns."/>
                            </StackPanel>
                        </Button>
                        
                        <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Reports"
                                IsVisible="{Binding CanSeeReportsModule}">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="{StaticResource IconReports}" Width="18"/>
                                <TextBlock Text="Rapports"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="16,20">
                     <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Notifications">
                         <Grid>
                             <StackPanel Orientation="Horizontal" Spacing="14">
                                 <PathIcon Data="{StaticResource IconNotifications}" Width="18"/>
                                 <TextBlock Text="Notifications"/>
                             </StackPanel>
                             <Border Background="{DynamicResource ErrorBrush}" 
                                     CornerRadius="10" MinWidth="18" Height="18" 
                                     HorizontalAlignment="Right" Margin="0,0,0,0"
                                     IsVisible="{Binding UnreadNotificationsCount, Converter={x:Static converters:IsGreaterThanZeroConverter.Instance}}">
                                 <TextBlock Text="{Binding UnreadNotificationsCount}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
                             </Border>
                         </Grid>
                    </Button>
                    
                    <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="0,2,0,4"
                            IsVisible="{Binding CanSeeSettingsModule}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{StaticResource IconSettings}" Width="18"/>
                            <TextBlock Text="Paramètres"/>
                        </StackPanel>
                    </Button>

                    <!-- Module Utilisateurs (Admin uniquement) -->
                    <Button Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Users" Margin="0,2,0,10"
                            IsVisible="{Binding CanSeeUsersModule}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{StaticResource IconUser}" Width="18"/>
                            <TextBlock Text="Utilisateurs"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- User card with profile and logout -->
                    <Border Background="{DynamicResource SurfaceLightBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentFadeBrush}">
                                    <TextBlock Text="{Binding CurrentUserInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserDisplayName}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CurrentUserRole}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*, 8, *">
                                <Button Content="Mon Profil" FontSize="11" Padding="6,4"
                                        Command="{Binding OpenProfileCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{DynamicResource AccentFadeBrush}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        BorderThickness="0" CornerRadius="4"/>
                                <Button Grid.Column="2" Content="Déconnexion" FontSize="11" Padding="6,4"
                                        Command="{Binding LogoutCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="#33FF453A"
                                        Foreground="{DynamicResource ErrorBrush}"
                                        BorderThickness="0" CornerRadius="4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            
            <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                     Background="#33FF453A" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="0,0,0,1" Padding="15,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Data="M12,2 L2,22 H22 L12,2 Z M12,18 V20 M12,10 V16" Foreground="{DynamicResource ErrorBrush}" Width="16"/>
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Margin="10,0" VerticalAlignment="Center" FontWeight="Medium"/>
                    <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="{DynamicResource ErrorBrush}" Padding="5"/>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="30"/>
        </Grid>
    </Grid>
</Window>