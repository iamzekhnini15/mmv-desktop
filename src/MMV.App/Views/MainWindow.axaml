<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:MMV.App"
        xmlns:vm="using:MMV.App.ViewModels"
        xmlns:converters="using:MMV.App.Converters"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="MMV.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ManageMyVision"
        Width="1600" Height="900"
        Background="#1D1D1D">

    <DockPanel Background="#1D1D1D">
        <!-- Header professionnel Apple style -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" BorderBrush="#424245" BorderThickness="0,0,0,1" Padding="28,16">
            <Grid ColumnDefinitions="1*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="👓" FontSize="32"/>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="ManageMyVision" FontSize="22" FontWeight="700" Foreground="#FFFFFF"/>
                        <TextBlock Text="Gestion Optique Professionnelle" FontSize="12" Foreground="#A1A1A6"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Admin" FontSize="13" Foreground="#A1A1A6"/>
                    <Button Content="Déconnexion" Padding="14,9" Background="#2D2D2D" Foreground="#FFFFFF" 
                           BorderThickness="1" BorderBrush="#424245" CornerRadius="8" FontSize="13" FontWeight="500" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <DockPanel Background="#1D1D1D">
            <!-- Sidebar Apple style -->
            <Border DockPanel.Dock="Left" Width="280" Background="#2D2D2D" BorderBrush="#424245" BorderThickness="0,0,1,0" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="3">
                        <!-- Titre du menu -->
                        <TextBlock Text="MENU" FontSize="11" FontWeight="700" Foreground="#A1A1A6" Margin="12,16,0,12" LetterSpacing="0.8"/>
                        
                        <!-- Boutons de navigation avec icônes -->
                        <Button Content="📊  Tableau de Bord" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                        <Button Content="👥  Clients" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                        <Button Content="📦  Produits" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Products"/>
                        <Button Content="🔖  Ordonnances" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Prescriptions"/>
                        <Button Content="📋  Commandes" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Orders"/>
                        <Button Content="💳  Ventes" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Sales"/>
                        
                        <!-- Bouton Notifications avec badge -->
                        <Grid>
                            <Button Content="🔔  Notifications" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Notifications"/>
                            <Border Background="#FF453A"
                                    CornerRadius="10"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    IsVisible="{Binding UnreadNotificationsCount, Converter={x:Static converters:IsGreaterThanZeroConverter.Instance}}">
                                <TextBlock Text="{Binding UnreadNotificationsCount}"
                                           FontSize="10"
                                           FontWeight="700"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        
                        <Button Content="📈  Rapports" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                        
                        <!-- Séparateur -->
                        <Separator Margin="0,12" Background="#424245"/>
                        
                        <Button Content="⚙️  Paramètres" Classes="NavButton" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Zone de contenu principal -->
            <Border Background="#1D1D1D" Padding="28">
                <Grid RowDefinitions="Auto,*">
                    <!-- Barre d'erreur Apple style -->
                    <StackPanel Spacing="12" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Border Background="#3A1010" CornerRadius="10" Padding="16" BorderBrush="#652020" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#FF3B30" TextWrapping="Wrap" Margin="12,0,0,0" FontSize="13" FontWeight="500"/>
                                <Button Grid.Column="2" Content="×" Foreground="#FF3B30" Background="Transparent" BorderThickness="0" FontSize="22" Padding="0" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Contenu dynamique (CurrentView) -->
                    <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </DockPanel>
    </DockPanel>

</Window>
