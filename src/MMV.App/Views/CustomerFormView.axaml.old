<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MMV.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="MMV.App.Views.CustomerFormView"
             x:DataType="vm:CustomerFormViewModel"
             Background="#1D1D1D">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="Transparent" Padding="24,16" BorderBrush="#424245" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0" 
                        Content="← Retour" 
                        Click="ButtonRetour_Click" 
                        Background="Transparent" 
                        Foreground="#A1A1A6" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        FontSize="13"
                        Padding="0"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Nouveau Client" 
                              FontSize="18" 
                              FontWeight="700" 
                              Foreground="#FFFFFF"/>
                    <TextBlock Text="Complétez les informations ci-dessous" 
                              FontSize="12" 
                              Foreground="#A1A1A6"/>
                </StackPanel>
                
                <Button Grid.Column="2" 
                        Content="Annuler" 
                        Click="ButtonRetour_Click"
                        Background="Transparent" 
                        Foreground="#FFFFFF" 
                        Padding="16,8" 
                        BorderThickness="1"
                        BorderBrush="#424245"
                        CornerRadius="8" 
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="500"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"/>
                
                <Button Grid.Column="3" 
                        Content="💾 Enregistrer" 
                        Click="ButtonEnregistrer_Click"
                        Background="#0A84FF" 
                        Foreground="#FFFFFF" 
                        Padding="20,8" 
                        BorderThickness="0" 
                        CornerRadius="8" 
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="600"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- Formulaire unifié -->
        <ScrollViewer Grid.Row="1" Padding="24,20">
            <Border Background="#2D2D2D" CornerRadius="12" Padding="24" HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    
                    <!-- Ligne 1: Prénom, Nom, Date de naissance -->
                    <Grid Grid.Row="0" ColumnDefinitions="1*,1*,1*" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Prénom *" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <TextBox Text="{Binding FirstName}" 
                                     Watermark="Jean"
                                     FontSize="13"
                                     Padding="10,8"
                                     Background="#1D1D1D"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#424245"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,6,0">
                            <TextBlock Text="Nom *" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <TextBox Text="{Binding LastName}" 
                                     Watermark="Dupont"
                                     FontSize="13"
                                     Padding="10,8"
                                     Background="#1D1D1D"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#424245"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="Date de naissance" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <DatePicker SelectedDate="{Binding BirthDate}" 
                                       Background="#1D1D1D" 
                                       Foreground="#FFFFFF" 
                                       BorderBrush="#424245" 
                                       BorderThickness="1" 
                                       CornerRadius="6" 
                                       Padding="10,8"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Ligne 2: Email, Téléphone -->
                    <Grid Grid.Row="1" ColumnDefinitions="1*,1*" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Email" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <TextBox Text="{Binding Email}" 
                                     Watermark="exemple@email.com"
                                     FontSize="13"
                                     Padding="10,8"
                                     Background="#1D1D1D"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#424245"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="Téléphone" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <TextBox Text="{Binding Phone}" 
                                     Watermark="06 12 34 56 78"
                                     FontSize="13"
                                     Padding="10,8"
                                     Background="#1D1D1D"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#424245"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Séparateur -->
                    <Border Grid.Row="2" Height="1" Background="#424245" Margin="0,4,0,20"/>
                    
                    <!-- Ligne 3: Adresse -->
                    <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,16">
                        <TextBlock Text="Adresse complète" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                        <TextBox Text="{Binding Address}" 
                                 Watermark="12 rue de la République"
                                 FontSize="13"
                                 Padding="10,8"
                                 Background="#1D1D1D"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#424245"
                                 BorderThickness="1"
                                 CornerRadius="6"/>
                    </StackPanel>
                    
                    <!-- Ligne 4: Ville, Code postal -->
                    <Grid Grid.Row="4" ColumnDefinitions="2*,1*" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Ville" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <TextBox Text="{Binding City}" 
                                     Watermark="Paris"
                                     FontSize="13"
                                     Padding="10,8"
                                     Background="#1D1D1D"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#424245"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="Code postal" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <TextBox Text="{Binding PostalCode}" 
                                     Watermark="75000"
                                     FontSize="13"
                                     Padding="10,8"
                                     Background="#1D1D1D"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#424245"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Séparateur -->
                    <Border Grid.Row="5" Height="1" Background="#424245" Margin="0,4,0,20"/>
                    
                    <!-- Ligne 5: Numéro SS, Mutuelle -->
                    <Grid Grid.Row="6" ColumnDefinitions="1*,1*" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="Numéro de sécurité sociale" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <TextBox Text="{Binding SocialSecurityNumber}" 
                                     Watermark="1 23 45 67 890 123"
                                     FontSize="13"
                                     Padding="10,8"
                                     Background="#1D1D1D"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#424245"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                            <TextBlock Text="Mutuelle / Assurance" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                            <TextBox Text="{Binding InsuranceName}" 
                                     Watermark="Nom de la mutuelle"
                                     FontSize="13"
                                     Padding="10,8"
                                     Background="#1D1D1D"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#424245"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Ligne 6: Notes -->
                    <StackPanel Grid.Row="7" Spacing="4">
                        <TextBlock Text="Notes et informations complémentaires" Foreground="#A1A1A6" FontSize="11" FontWeight="500"/>
                        <TextBox Text="{Binding Notes}" 
                                 Watermark="Ajoutez des notes concernant ce client..."
                                 AcceptsReturn="True" 
                                 TextWrapping="Wrap" 
                                 Height="80" 
                                 FontSize="13"
                                 Padding="10,8"
                                 Background="#1D1D1D"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#424245"
                                 BorderThickness="1"
                                 CornerRadius="6"
                                 VerticalAlignment="Stretch"/>
                    </StackPanel>
                    
                </Grid>
            </Border>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="#2D2D2D" 
                Padding="24,12" 
                BorderBrush="#424245" 
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" 
                          Text="Les champs marqués d'un astérisque (*) sont obligatoires" 
                          FontSize="11" 
                          Foreground="#A1A1A6"
                          VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Formulaire non enregistré" 
                              FontSize="11" 
                              Foreground="#A1A1A6"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>