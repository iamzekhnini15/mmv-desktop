<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:MMV.App.ViewModels"
            x:Class="MMV.App.Views.SettingsView"
            x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel MaxWidth="600" HorizontalAlignment="Left" Spacing="24">

            <!-- En-tête -->
            <TextBlock Text="Paramètres" Classes="h1"/>

            <!-- Section Apparence -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Apparence" FontSize="15" FontWeight="SemiBold"/>

                    <!-- Toggle Dark Mode -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{DynamicResource AccentFadeBrush}">
                            <TextBlock Text="🌙" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Mode sombre" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Text="{Binding ThemeLabel}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsDarkMode}"
                                      VerticalAlignment="Center"
                                      OnContent="" OffContent=""/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section Informations -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="À propos" FontSize="15" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Version" FontSize="14"/>
                        <TextBlock Grid.Column="1" Text="1.0.0" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Application" FontSize="14"/>
                        <TextBlock Grid.Column="1" Text="ManageMyVision" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
