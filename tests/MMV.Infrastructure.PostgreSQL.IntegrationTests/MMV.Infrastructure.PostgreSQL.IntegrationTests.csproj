<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P4-5F (ADR-PROD-DB-008) : tests d'intégration contre un VRAI serveur PostgreSQL.

    Séparé de la suite unitaire (§5.1, §5.9) : sans serveur, ces tests s'ignorent explicitement en local et
    ÉCHOUENT en CI (§5.4). Leur nombre n'est jamais additionné à la baseline unitaire (§5.7, Q7).
    Aucun paquet nouveau : mêmes paquets et mêmes versions que les projets de test existants ; Npgsql arrive
    par transitivité de MMV.Infrastructure.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- FluentAssertions épinglé en 6.x : v7+ est sous licence commerciale. -->
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MMV.Domain\MMV.Domain.csproj" />
    <ProjectReference Include="..\..\src\MMV.Application\MMV.Application.csproj" />
    <ProjectReference Include="..\..\src\MMV.Infrastructure\MMV.Infrastructure.csproj" />
    <!-- Chaîne de migrations PostgreSQL : chargée par nom (MigrationsAssembly), elle doit être copiée en sortie. -->
    <ProjectReference Include="..\..\src\MMV.Infrastructure.PostgreSQL.Migrations\MMV.Infrastructure.PostgreSQL.Migrations.csproj" />
    <!-- P4-6B (C16) : preuves serveur du cycle de vie (Lifecycle/, I-1 … I-14) contre l'outil réel. -->
    <ProjectReference Include="..\..\src\MMV.DatabaseManager\MMV.DatabaseManager.csproj" />
    <!-- P4-10 : processus « poste » des tests multi-processus, lancé par chemin (construit, jamais référencé). -->
    <ProjectReference Include="..\MMV.MultiProcess.Worker\MMV.MultiProcess.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
